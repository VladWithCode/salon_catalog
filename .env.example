# Local environment for the new Next.js app.
# Copy to .env.local and adjust if needed.

# URL of the existing Go backend. The Next.js server calls this for
# catalog listings, socials, and the contact form.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Used by metadata for absolute URLs in OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
