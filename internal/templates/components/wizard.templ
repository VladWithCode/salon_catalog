package components

import "github.com/vladwithcode/salon_catalog/internal/db"
import "fmt"

templ WizardModal(steps []db.WizardStep, currentStep int) {
	<div class="flex items-center justify-center min-h-screen p-4">
		<div class="bg-white rounded-xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden" data-wizard-container>
			<!-- Header -->
			<div class="bg-gradient-to-r from-primary to-accent p-6 text-white relative">
				<button
					class="absolute top-4 right-4 text-white hover:text-gray-200 transition-colors"
					data-close-wizard
				>
					<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
					</svg>
				</button>
				<h2 class="text-2xl font-bold mb-2">Asistente de Planeación</h2>
				<p class="text-white/90">Te ayudamos a crear el evento perfecto paso a paso</p>
				<!-- Progress Bar -->
				<div class="mt-6">
					<div class="flex justify-between items-center mb-2">
						<span class="text-sm font-medium">Progreso</span>
						<span class="text-sm font-medium" data-progress-text>
							Paso { currentStep + 1 } de { len(steps) }
						</span>
					</div>
					<div class="w-full bg-white/20 rounded-full h-2">
						<div
							class="bg-white h-2 rounded-full transition-all duration-500"
							style={ templ.KV("width", fmt.Sprintf("%.1f%%", float64(currentStep+1)/float64(len(steps))*100)) }
							data-progress-bar
						></div>
					</div>
				</div>
			</div>
			<!-- Content Area -->
			<div class="flex h-[calc(90vh-180px)]">
				<!-- Steps Sidebar -->
				<div class="w-1/4 bg-gray-50 p-4 border-r overflow-y-auto">
					<h3 class="font-semibold text-gray-700 mb-4">Pasos</h3>
					<div class="space-y-2">
						for i, step := range steps {
							<div
								class={
									"flex items-center p-3 rounded-lg transition-colors cursor-pointer",
									templ.KV("bg-accent text-white", i == currentStep),
									templ.KV("bg-white hover:bg-gray-100", i != currentStep),
									templ.KV("opacity-50", i > currentStep),
								}
							>
								<div
									class={
										"w-6 h-6 rounded-full flex items-center justify-center text-xs font-bold mr-3",
										templ.KV("bg-white text-accent", i == currentStep),
										templ.KV("bg-gray-300 text-gray-600", i != currentStep && i > currentStep),
										templ.KV("bg-green-500 text-white", i < currentStep),
									}
								>
									if i < currentStep {
										✓
									} else {
										{ fmt.Sprintf("%d", i+1) }
									}
								</div>
								<span class="text-sm font-medium">{ step.Name }</span>
							</div>
						}
					</div>
				</div>
				<!-- Main Content -->
				<div class="flex-1 flex flex-col">
					<div class="flex-1 overflow-y-auto" id="wizard-step-content">
						if currentStep < len(steps) {
							@WizardStep(steps[currentStep], currentStep)
						}
					</div>
					<!-- Footer Actions -->
					<div class="p-6 border-t bg-gray-50 flex justify-between items-center">
						<button
							class={
								"px-6 py-2 rounded-lg font-medium transition-colors",
								templ.KV("bg-gray-200 text-gray-400 cursor-not-allowed", currentStep == 0),
								templ.KV("bg-gray-200 text-gray-700 hover:bg-gray-300", currentStep > 0),
							}
							if currentStep > 0 {
								hx-get={ fmt.Sprintf("/wizard/step/%s", steps[currentStep-1].ID) }
								hx-target="#wizard-modal"
								hx-include="[data-wizard-selections]"
							}
							disabled?={ currentStep == 0 }
						>
							← Anterior
						</button>
						<div class="flex gap-3">
							<button
								class="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg font-medium hover:bg-gray-300 transition-colors"
								data-close-wizard
							>
								Cancelar
							</button>
							if currentStep < len(steps)-1 {
								<button
									class="px-6 py-2 bg-accent text-white rounded-lg font-medium hover:bg-accent/90 transition-colors"
									hx-post={ fmt.Sprintf("/wizard/step/%s", steps[currentStep].ID) }
									hx-target="#wizard-modal"
									hx-include="[data-wizard-selections]"
									data-next-step
								>
									Siguiente →
								</button>
							} else {
								<button
									class="px-6 py-2 bg-green-600 text-white rounded-lg font-medium hover:bg-green-700 transition-colors"
									hx-post="/event/save-plan"
									hx-include="[data-wizard-selections]"
									data-finish-wizard
								>
									Finalizar Planeación
								</button>
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ WizardStep(step db.WizardStep, stepIndex int) {
	<div class="p-6" data-wizard-step={ fmt.Sprintf("%d", stepIndex) }>
		<div class="mb-6">
			<h3 class="text-2xl font-bold text-gray-800 mb-2">{ step.Name }</h3>
			<p class="text-gray-600">{ step.Description }</p>
			if step.Required {
				<span class="inline-block mt-2 px-2 py-1 bg-red-100 text-red-800 text-xs font-medium rounded">
					Requerido
				</span>
			}
		</div>
		<!-- Selection Type Indicator -->
		<div class="mb-4 p-3 bg-blue-50 rounded-lg border-l-4 border-blue-400">
			<p class="text-sm text-blue-800">
				if step.MultiSelect {
					<strong>Selección múltiple:</strong> Puedes elegir varios elementos
				} else {
					<strong>Selección única:</strong> Elige solo una opción
				}
			</p>
		</div>
		<!-- Products Grid -->
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
			// TODO: Add product fetching
		</div>
		<!-- Selected Items Summary -->
		<div class="mt-8 p-4 bg-gray-50 rounded-lg" id={ fmt.Sprintf("selected-summary-%d", stepIndex) }>
			<h4 class="font-semibold text-gray-700 mb-2">Seleccionados:</h4>
			<div class="text-sm text-gray-600" data-selected-items>
				Ningún elemento seleccionado
			</div>
		</div>
	</div>
}

templ WizardScript() {
	<script>
        document.addEventListener('DOMContentLoaded', function() {

        });

        class WizardManager {
            constructor() {
                this.initializeSelections();
                this.bindEvents();
            }

            initializeSelections() {
                document.querySelectorAll('[data-product-checkbox], [data-product-radio]').forEach(input => {
                    input.addEventListener('change', (e) => {
                        this.handleSelection(e.target);
                    });
                });
            }

            handleSelection(input) {
                const card = input.closest('[data-product-card]');
                const overlay = card.querySelector('[data-selection-overlay]');
                const button = card.querySelector('[data-selection-button]');

                if (input.checked) {
                    card.classList.add('border-accent', 'bg-accent/5');
                    overlay.classList.remove('opacity-0');
                    button.textContent = 'Seleccionado';
                    button.classList.add('bg-accent', 'text-white', 'border-accent');

                    if (input.type === 'radio') {
                        this.deselectOthersInGroup(input);
                    }
                } else {
                    card.classList.remove('border-accent', 'bg-accent/5');
                    overlay.classList.add('opacity-0');
                    button.textContent = 'Seleccionar';
                    button.classList.remove('bg-accent', 'text-white', 'border-accent');
                }

                this.updateSelectedSummary();
                this.animateSelection(card);
            }

            deselectOthersInGroup(selectedInput) {
                document.querySelectorAll(`[name="${selectedInput.name}"]`).forEach(input => {
                    if (input !== selectedInput && input.checked) {
                        input.checked = false;
                        this.handleSelection(input);
                    }
                });
            }

            updateSelectedSummary() {
                const currentStep = document.querySelector('[data-wizard-step]');
                const stepIndex = currentStep.dataset.wizardStep;
                const summaryContainer = document.querySelector(`[data-selected-items]`);

                const selected = document.querySelectorAll(`[name*="step_${stepIndex}"][checked], [name*="step_${stepIndex}"]:checked`);

                if (selected.length === 0) {
                    summaryContainer.textContent = 'Ningún elemento seleccionado';
                } else {
                    const items = Array.from(selected).map(input => {
                        const card = input.closest('[data-product-card]');
                        const name = card.querySelector('h4').textContent;
                        return name;
                    });
                    summaryContainer.textContent = items.join(', ');
                }
            }

            animateSelection(card) {
                gsap.fromTo(card,
                    {scale: 1},
                    {scale: 1.05, duration: 0.1, yoyo: true, repeat: 1}
                );
            }

            bindEvents() {
                // Handle wizard step navigation
                document.body.addEventListener('htmx:afterSwap', (e) => {
                    if (e.detail.target.id === 'wizard-step-content' ||
                        e.detail.target.closest('#wizard-modal')) {
                        // Re-initialize selections when step changes
                        setTimeout(() => this.initializeSelections(), 50);
                    }
                });
            }
        }
    </script>
}
