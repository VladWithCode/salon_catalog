package components

const (
IconEmail = "email"
IconPassword = "password"
IconUser = "user"
IconPhone = "phone"
IconSearch = "search"
)

templ renderIcon(iconName string, hasError bool) {
switch iconName {
case IconEmail:
<svg class={ "h-5 w-5" , templ.KV("text-red-400", hasError), templ.KV("text-gray-400", !hasError) } fill="none"
    stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207">
    </path>
</svg>
case IconPassword:
<svg class={ "h-5 w-5" , templ.KV("text-red-400", hasError), templ.KV("text-gray-400", !hasError) } fill="none"
    stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
</svg>
case IconUser:
<svg class={ "h-5 w-5" , templ.KV("text-red-400", hasError), templ.KV("text-gray-400", !hasError) } fill="none"
    stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
</svg>
case IconPhone:
<svg class={ "h-5 w-5" , templ.KV("text-red-400", hasError), templ.KV("text-gray-400", !hasError) } fill="none"
    stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z">
    </path>
</svg>
case IconSearch:
<svg class={ "h-5 w-5" , templ.KV("text-red-400", hasError), templ.KV("text-gray-400", !hasError) } fill="none"
    stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
</svg>
default:
<svg class={ "h-5 w-5" , templ.KV("text-red-400", hasError), templ.KV("text-gray-400", !hasError) } fill="none"
    stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
    </path>
</svg>
}
}

templ TimesIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square " , class } viewBox="0 0 24 24" stroke="currentColor" fill="none" { attr... }>
    <path d="M16 8L8 16M8 8L16 16" stroke-width="2" stroke-linecap="round"></path>
</svg>
}

templ CheckIcon(class string, attr templ.Attributes) {
<svg class={ " aspect-square " , class } viewBox="0 0 24 24" fill="none" stroke="currentColor" { attr... }>
    <path d="M7 12L9.89075 14.8907V14.8907C9.95114 14.951 10.049 14.9511 10.1094 14.8907V14.8907L17 8" stroke-width="2"
        stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
}

templ BarsIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square" , class } fill="none" stroke="currentColor" viewBox="0 0 24 24" { attr... }>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M4 6h16M4 12h16M4 18h16"></path>
</svg>
}

templ GraphIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square" , class, } fill="none" stroke="currentColor" viewBox="0 0 24 24" { attr... }>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2-2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
    </path>
</svg>
}

templ EmailIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square" , class } fill="none" stroke="currentColor" viewBox="0 0 24 24" { attr... }>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
</svg>
}

templ SheetIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square" , class, } fill="none" stroke="currentColor" viewBox="0 0 24 24" { attr... }>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
    </path>
</svg>
}

templ PlusIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square" , class, } fill="none" stroke="currentColor" viewBox="0 0 24 24" { attr... }>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
</svg>
}

templ ChevronIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square" , class, } fill="none" stroke="currentColor" viewBox="0 0 24 24" { attr... }>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
</svg>
}

templ LoadingIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-3/1 " , class } fill="currentColor" stroke="currentColor" viewBox="0 0 300 100" { attr... }>
    <circle stroke-width="15" r="15" cx="75" cy="50">
        <animate attributeName="cy" calcMode="spline" dur="1.5" values="35;65;35;" keySplines=".5 0 .5 1;.5 0 .5 1"
            repeatCount="indefinite" begin="-.4"></animate>
    </circle>
    <circle stroke-width="15" r="15" cx="150" cy="50">
        <animate attributeName="cy" calcMode="spline" dur="1.5" values="35;65;35;" keySplines=".5 0 .5 1;.5 0 .5 1"
            repeatCount="indefinite" begin="-.2"></animate>
    </circle>
    <circle stroke-width="15" r="15" cx="225" cy="50">
        <animate attributeName="cy" calcMode="spline" dur="1.5" values="35;65;35;" keySplines=".5 0 .5 1;.5 0 .5 1"
            repeatCount="indefinite" begin="0"></animate>
    </circle>
</svg>
}

templ BoxIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square " , class } fill="none" stroke="currentColor" viewBox="0 0 24 24" { attr... }>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
</svg>
}

templ ImageIcon(class string, attr templ.Attributes) {
<svg class={ "aspect-square " , class } viewBox="0 0 24 24" stroke="currentColor" fill="none" { attr... }>
    <path
        d="M3 8.976C3 4.05476 4.05476 3 8.976 3H15.024C19.9452 3 21 4.05476 21 8.976V15.024C21 19.9452 19.9452 21 15.024 21H8.976C4.05476 21 3 19.9452 3 15.024V8.976Z"
        stroke-width="2"></path>
    <path d="M17.0045 16.5022L12.7279 12.2256C9.24808 8.74578 7.75642 8.74578 4.27658 12.2256L3 13.5022"
        stroke-width="2" stroke-linecap="round"></path>
    <path d="M21 13.6702C18.9068 12.0667 17.4778 12.2919 15.198 14.3459" stroke="#323232" stroke-width="2"
        stroke-linecap="round"></path>
    <path
        d="M17 8C17 8.55228 16.5523 9 16 9C15.4477 9 15 8.55228 15 8C15 7.44772 15.4477 7 16 7C16.5523 7 17 7.44772 17 8Z"
        stroke-width="2"></path>
</svg>
}

