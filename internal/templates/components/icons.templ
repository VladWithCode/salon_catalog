         c-11.782,0-21.333,9.551-21.333,21.333V64C319.997,75.782,329.548,85.333,341.33,85.333z"></path>
    <path d="M341.33,277.333c-11.782,0-21.333,9.551-21.333,21.333V320c0,11.782,9.551,21.333,21.333,21.333
         c11.782,0,21.333-9.551,21.333-21.333v-21.333C362.663,286.885,353.112,277.333,341.33,277.333z"></path>
