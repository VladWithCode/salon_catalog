    <path d="M323.658,263.766l75.435-75.435c8.333-8.333,8.331-21.843-0.004-30.173l-45.269-45.248
         c-8.333-8.329-21.839-8.326-30.169,0.006l-75.152,75.173c-0.079,0.077-0.165,0.142-0.243,0.22L6.251,430.334
