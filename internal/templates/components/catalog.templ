package components

import (
	"fmt"
	"github.com/vladwithcode/salon_catalog/internal/db"
	"github.com/vladwithcode/salon_catalog/internal/templates/util"
)

func getTotalProductCount(categories []db.CatalogCtg) int {
	total := 0
	for _, category := range categories {
		total += category.ProductCount
	}
	return total
}

templ CategoryFilters(categories []db.CatalogCtg, activeCategory string) {
	<div class="flex overflow-x-auto gap-2 scrollbar-hide">
		<!-- All Categories -->
		<button
			class={
				"px-4 py-2 rounded-full font-medium whitespace-nowrap transition-colors flex-shrink-0",
				templ.KV("bg-accent text-white", activeCategory == ""),
				templ.KV("bg-gray-200 text-gray-700 hover:bg-gray-300", activeCategory != ""),
			}
			hx-get="/catalog/products"
			hx-target="#products"
			hx-swap="innerHTML"
			hx-indicator="[data-products-spinner]"
			hx-push-url="/catalogo"
			data-click-handler-selector="category-filter"
			data-category-filter=""
		>
			Todos ({ getTotalProductCount(categories) })
		</button>
		<!-- Category Filters -->
		for _, category := range categories {
			<button
				class={
					"px-4 py-2 rounded-full font-medium whitespace-nowrap transition-colors flex-shrink-0",
					templ.KV("bg-accent text-white", activeCategory == category.Name),
					templ.KV("bg-gray-200 text-gray-700 hover:bg-gray-300", activeCategory != category.Name),
				}
				hx-get={ fmt.Sprintf("/catalog/products?categoria=%s", category.Name) }
				hx-target="#products"
				hx-swap="innerHTML"
				hx-indicator="[data-products-spinner]"
				hx-push-url={ fmt.Sprintf("/catalogo?categoria=%s", category.Name) }
				data-click-handler-selector="category-filter"
				data-category-filter={ category.ID }
			>
				{ category.Name } ({ category.ProductCount })
			</button>
		}
	</div>
	<!-- Loading Indicator -->
	/* <div id="loading-indicator" class="htmx-indicator">
        <div class="flex items-center justify-center py-8">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent"></div>
            <span class="ml-3 text-gray-600">Cargando productos...</span>
        </div>
    </div> */
}

templ ProductGrid(result *db.CatalogProductFilterResult) {
	<div class="space-y-6" id="products-grid-content">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" data-products-container>
			for _, product := range result.Products {
				@ProductCard(product)
			}
		</div>
		<!-- Load More / Pagination -->
		if result.TotalPages > 1 {
			<div class="flex gap-2 items-stretch justify-center mt-8">
				<button
					class="p-2 bg-accent text-light rounded-lg disabled:opacity-80 disabled:brightness-90"
					disabled?={ !result.HasPrevious }
					hx-get={ fmt.Sprintf("/catalog/products?pagina=%d&categoria=", result.Page-1, util.ExtractURLQuery(ctx).Get("categoria")) }
					hx-target="#products-grid-content"
					hx-indicator="[data-products-spinner]"
					hx-push-url={ fmt.Sprintf("/catalogo?pagina=%d&categoria=%s", result.Page-1, util.ExtractURLQuery(ctx).Get("categoria")) }
					hx-vals={ fmt.Sprintf(`"categoria": "%s"`, util.ExtractURLQuery(ctx).Get("categoria")) }
					data-click-handler-selector="catalog-pagination"
					data-catalog-pagination="prev"
				>
					@ChevronIcon("h-6 rotate-90", nil)
				</button>
				<div class="max-w-fit flex-1 flex items-stretch px-2 py-1 bg-accent text-light rounded-lg">
					for i := 1; i <= result.TotalPages; i++ {
						{{ isCurrent := i == result.Page }}
						<button
							class={
								"px-4 flex text-light items-center justify-center rounded-lg",
								templ.KV("bg-primary hover:bg-primary/90", isCurrent),
								templ.KV("bg-transparent hover:bg-primary/90", !isCurrent),
							}
							hx-get={ fmt.Sprintf("/catalog/products?pagina=%d&categoria=", i, util.ExtractURLQuery(ctx).Get("categoria")) }
							hx-target="#products-grid-content"
							hx-indicator="[data-products-spinner]"
							hx-push-url={ fmt.Sprintf("/catalogo?pagina=%d&categoria=%s", i, util.ExtractURLQuery(ctx).Get("categoria")) }
							data-click-handler-selector="catalog-pagination"
							data-catalog-pagination="page"
						>
							{ i }
						</button>
					}
				</div>
				<button
					class="p-2 bg-accent text-light rounded-lg disabled:opacity-80 disabled:brightness-90"
					disabled?={ !result.HasNext }
					hx-get={ fmt.Sprintf("/catalog/products?pagina=%d&categoria=", result.Page+1, util.ExtractURLQuery(ctx).Get("categoria")) }
					hx-target="#products-grid-content"
					hx-indicator="[data-products-spinner]"
					hx-push-url={ fmt.Sprintf("/catalogo?pagina=%d&categoria=%s", result.Page+1, util.ExtractURLQuery(ctx).Get("categoria")) }
					data-click-handler-selector="catalog-pagination"
					data-catalog-pagination="next"
				>
					@ChevronIcon("h-6 -rotate-90", nil)
				</button>
			</div>
		}
	</div>
}

templ ProductCard(product *db.CatalogProd) {
	<div
		class="bg-gray-50 flex flex-col rounded-lg shadow-md overflow-hidden border border-gray-200 hover:shadow-lg transition-all duration-300 group opacity-0 translate-y-6"
		data-product-id={ product.ID }
	>
		<!-- Product Image -->
		<div class="aspect-square overflow-hidden bg-gray-100 relative">
			// src="/static/assets/chenacolo_24.jpeg"
			<button
				class="w-full aspect-square xl:pointer-events-none"
				hx-get={ fmt.Sprintf("/catalogo/producto/%s", product.Slug) }
				hx-target="#product-modal"
				hx-swap="outerHTML"
				hx-indicator="#product-modal-loading"
				hx-push-url={ fmt.Sprintf("/catalogo/producto/%s", product.Slug) }
			>
				<img
					src={ fmt.Sprintf("/static/uploads/%s", product.ImageURL) }
					alt={ product.Name }
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
					loading="lazy"
				/>
			</button>
			<!-- Quick Actions Overlay -->
			<div class="invisible xl:visible absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
				<div class="space-x-2">
					<button
						class="p-2 bg-white rounded-full text-primary hover:bg-gray-100 transition-colors"
						hx-get={ fmt.Sprintf("/catalogo/producto/%s", product.Slug) }
						hx-target="#product-modal"
						hx-indicator="#product-modal-loading"
						hx-push-url={ fmt.Sprintf("/catalogo/producto/%s", product.Slug) }
						hx-swap="outerHTML"
						title="Ver detalles"
					>
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
						</svg>
					</button>
					<button
						class="p-2 bg-accent rounded-full text-white hover:bg-accent/90 transition-colors"
						hx-post="/cart/add"
						hx-vals={ fmt.Sprintf(`{"product_id": "%s", "source": "catalog"}`, product.ID) }
						hx-target="#cart-sidebar"
						title="Añadir a selección"
						data-add-to-cart
					>
						<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
						</svg>
					</button>
				</div>
			</div>
			<!-- Category Badge -->
			<div class="absolute top-3 left-3">
				<span class="px-2 py-1 bg-white/90 text-xs font-medium text-gray-700 rounded-full">
					{ product.CategoryName }
				</span>
			</div>
			<!-- Availability Badge -->
			if !product.Available {
				<div class="absolute top-3 right-3">
					<span class="px-2 py-1 bg-red-500 text-white text-xs font-medium rounded-full">
						No disponible
					</span>
				</div>
			}
		</div>
		<!-- Product Info -->
		<div class="flex-1 flex flex-col p-4">
			<div class="flex-1 basis-full">
				<h3 class="font-semibold text-gray-800 mb-2 line-clamp-2">{ product.Name }</h3>
				<p class="text-sm text-gray-600 mb-3 line-clamp-2">{ product.Description }</p>
			</div>
			<!-- Action Button -->
			<div class="flex-1">
				<button
					class={
						"grid grid-cols-1 grid-rows-1 place-items-center w-full py-2 rounded-lg font-medium transition-colors cart-item-add-btn relative",
						templ.KV("bg-accent text-white hover:bg-accent/90", product.Available),
						templ.KV("bg-gray-300 text-gray-500 cursor-not-allowed", !product.Available),
					}
					if product.Available {
						hx-post="/cart/add"
						hx-vals={ fmt.Sprintf(`{"product_id": "%s", "source": "catalog"}`, product.ID) }
						hx-target="#cart-sidebar"
						data-add-to-cart
					}
					disabled?={ !product.Available }
				>
					<div
						class="absolute inset-0 flex items-center justify-center bg-red-500 rounded-lg text-white text-xl opacity-0 z-10"
						data-add-item-error
					>
						✗  Error al añadir al carrito
					</div>
					<div
						class="absolute inset-0 flex items-center justify-center bg-green-500 rounded-lg text-white text-xl opacity-0 z-10"
						data-add-item-success
					>
						✓  Añadido al carrito
					</div>
					<div
						class="flex items-center col-start-1 row-start-1 place-self-center overflow-hidden z-0"
						data-add-item-label
					>
						if product.Available {
							Añadir a Selección
						} else {
							No Disponible
						}
					</div>
					<div
						class="col-start-1 row-start-1 place-self-center overflow-hidden"
						style="height: 0%;"
						data-add-item-spinner
					>
						@LoadingIcon("h-8", nil)
					</div>
				</button>
			</div>
		</div>
	</div>
}

type ProductModalState struct {
	Product         db.CatalogProd    `json:"-"`
	RelatedProducts []*db.CatalogProd `json:"-"`
	Error           string            `json:"-"`
}

templ ProductModal(state *ProductModalState) {
	<div class="fixed w-full inset-0 z-50 translate-y-full invisible overflow-hidden" id="product-modal-overlay">
		<div class="absolute inset-0 z-40 h-full bg-light flex items-center justify-center flex-col gap-4 text-primary opacity-0 pointer-events-none htmx-indicator" id="product-modal-loading">
			@LoadingIcon("h-16", nil)
			<p class="text-lg font-bold">Cargando producto...</p>
		</div>
		@templ.Fragment("productModalContent") {
			<div
				id="product-modal"
				class="relative z-0 bg-light w-full h-full xl:absolute xl:inset-x-0 xl:bottom-0 xl:h-4/5 xl:flex overflow-y-auto overflow-x-visible shadow-2xl xl:rounded-t-3xl"
				if state != nil {
					data-product-modal-open="open"
				} else {
					data-product-modal-open="closed"
				}
			>
				<div class="absolute top-2 right-2 z-40">
					<button
						class="text-secondary xl:text-primary rounded-full cursor-pointer rotate-0 hover:rotate-90 transition-[rotate]"
						data-close-modal="product-modal"
						data-click-handler-selector="close-product-modal"
					>
						@TimesIcon("h-10", nil)
					</button>
				</div>
				if state != nil {
					{{ product := state.Product }}
					<!-- Header Img -->
					<div class="fixed xl:relative top-0 h-2/3 xl:h-full xl:p-4 xl:flex-1 inset-x-0 z-0">
						<img
							id="product-modal-main-img"
							src={ fmt.Sprintf("/static/uploads/%s", product.ImageURL) }
							alt={ fmt.Sprintf("Imagen de producto %s", product.Name) }
							class="h-full object-cover object-center translate-y-6 opacity-0 xl:rounded-xl"
							data-modal-animate-enter
						/>
						<button class="absolute inset-0 h-full z-10 bg-light/60 opacity-0 hover:opacity-100 transition-opacity duration-300 ease-in cursor-pointer">
							<p class="text-4xl text-dark rounded-xl">Ver Galería</p>
						</button>
					</div>
					<div
						id="product-modal-gallery-popup"
						class="hidden xl:block xl:invisible fixed inset-0 z-30 p-4"
					></div>
					<!-- Add to Cart -->
					<div class="fixed inset-x-0 xl:left-1/2 bottom-0 xl:w-1/2 z-30 px-4 py-2">
						<button class="w-full bg-accent text-light text-xl font-bold rounded-lg shadow p-2">Añadir al carrito</button>
					</div>
					<!-- Content -->
					<div class="relative z-10 min-h-full w-full xl:flex-1 flex flex-col gap-4 px-4 pb-18 text-center overflow-hidden xl:overflow-y-auto bg-linear-to-b from-light/0 to-light to-[50vh] xl:from-light pt-[50vh] xl:pt-4">
						<div class="text-primary p-4 py-2 translate-y-6 opacity-0" data-modal-animate-enter>
							<span class="font-light text-current/80 sm:text-lg">{ product.CategoryName }</span>
							<h2 class="text-3xl sm:text-4xl md:text-5xl font-medium">{ product.Name }</h2>
						</div>
						<div class="flex gap-4 justify-center items-center font-medium translate-y-6 opacity-0" data-modal-animate-enter>
							<p class="flex items-center gap-1 text-current/80 sm:text-lg">
								if product.Available {
									@CheckIcon("h-5", nil)
									<span>Disponible</span>
								} else {
									@TimesIcon("h-5", nil)
									<span>No Disponible</span>
								}
							</p>
						</div>
						<div class="translate-y-6 opacity-0 sm:text-lg" data-modal-animate-enter>
							<p
								id="product-modal-description"
								class="text-neutral/80 leading-relaxed line-clamp-3"
							>{ product.LongDescription }</p>
							<button
								class="text-neutral font-medium"
								data-product-modal-read-more="collapsed"
								data-click-handler-selector="product-modal-read-more"
							>Leer más</button>
						</div>
						<!-- Gallery -->
						<div class="xl:hidden space-y-4 py-4">
							<h3 class="text-lg md:text-xl font-medium text-primary">Galería</h3>
							<div class="flex gap-4 h-52 sm:h-64 md:h-72 overflow-x-auto overflow-y-hidden">
								for i, img := range state.Product.Images {
									<button
										data-product-modal-gallery-img={ i }
										data-click-handler-selector="product-modal-gallery-img"
										class="h-full aspect-square rounded-lg drop-shadow-lg cursor-pointer scale-100 hover:scale-105 transition-[scale]"
									>
										<img
											src={ fmt.Sprintf("/static/uploads/%s", img) }
											alt={ fmt.Sprintf("Imagen de producto %s No. %d", state.Product.Name, i) }
											class="w-full h-full object-cover rounded-lg"
										/>
									</button>
								}
							</div>
							<div
								id="product-modal-gallery-wrapper"
								class="flex flex-col gap-4 h-0 overflow-hidden"
								data-product-modal-gallery="collapsed"
							>
								<img
									id="product-modal-gallery-display"
									class="w-full object-cover rounded-lg"
									src={ fmt.Sprintf("/static/uploads/%s", state.Product.ImageURL) }
								/>
								<button
									data-product-modal-gallery-close
									data-click-handler-selector="product-modal-gallery-close"
									class="bg-primary text-light rounded-lg p-2 font-medium"
								>
									Cerrar Galería
								</button>
							</div>
						</div>
						if len(state.RelatedProducts) > 0 {
							<div class="space-y-4 py-4">
								<h3 class="text-lg md:text-xl font-medium text-primary">Relacionados</h3>
								<div class="flex gap-2 h-52 md:h-64 lg:h-72 overflow-x-auto">
									for _, product := range state.RelatedProducts {
										<button
											class="relative shrink-0 grow-0 h-full aspect-square rounded-lg shadow overflow-hidden"
											hx-get={ fmt.Sprintf("/catalogo/producto/%s", product.ID) }
											hx-target="#product-modal"
											hx-swap="outerHTML"
											hx-indicator="#product-modal-loading"
											hx-push-url={ fmt.Sprintf("/catalogo/producto/%s", product.Slug) }
										>
											<img
												src={ fmt.Sprintf("/static/uploads/%s", product.ImageURL) }
												alt={ product.Name }
												class="w-full h-full object-cover"
											/>
											<div class="absolute bg-light/80 text-primary p-2 inset-x-0 bottom-0 min-h-1/4">
												<p class="text-sm md:text-base font-medium line-clamp-2">{ product.Name }</p>
											</div>
										</button>
									}
								</div>
							</div>
						}
					</div>
				}
			</div>
		}
	</div>
}

templ SearchBar(search string) {
	<div class="relative max-w-md mx-auto">
		<input
			type="search"
			placeholder="Buscar productos..."
			class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-accent focus:border-transparent"
			hx-get="/catalog/products"
			hx-target="#products"
			hx-swap="innerHTML"
			hx-trigger="input changed delay:300ms"
			hx-indicator="[data-products-spinner]"
			hx-push-url="/catalogo"
			name="buscar"
			data-search-input
			value={ search }
		/>
		<div class="absolute left-3 top-1/2 transform -translate-y-1/2 text-gray-400">
			<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
			</svg>
		</div>
		<div id="search-indicator" class="htmx-indicator absolute right-3 top-1/2 transform -translate-y-1/2">
			<div class="animate-spin rounded-full h-4 w-4 border-b-2 border-accent"></div>
		</div>
	</div>
}
