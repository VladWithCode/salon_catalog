package dashboard

import (
	"fmt"
	"github.com/vladwithcode/salon_catalog/internal/db"
	"github.com/vladwithcode/salon_catalog/internal/templates/components"
)

templ CategoriesTable(result *db.CategoryFilterResult) {
	<span id="categories-table-count" hx-swap-oob="true">({ fmt.Sprintf("%d", len(result.Categories)) }/ { fmt.Sprintf("%d", result.Total) })</span>
	<div class="max-w-screen-xl flex flex-col p-1 mx-auto">
		if result.HasError {
			<div class="flex-1 flex items-center justify-center gap-4 p-4">
				<h3 class="text-lg text-red-700 font-semibold">Algo salió mal</h3>
				<button
					type="button"
					class="text-lg underline underline-offset-2 text-accent font-bold tracking-wide"
					hx-get="/categorias"
					hx-target="#categories-table"
					hx-params="none"
					data-click-handler-selector="[data-categories-filter-clear]"
					data-categories-filter-clear
				>Limpiar Filtros</button>
			</div>
		}
		if len(result.Categories) == 0 {
			<div class="text-center p-4 space-y-2">
				<h3 class="">No se encontraron categorías que coincidan con tu búsqueda</h3>
				<button
					type="button"
					class="text-lg underline underline-offset-2 text-accent font-bold tracking-wide"
					hx-get="/categorias"
					hx-target="#categories-table"
					hx-params="none"
					data-click-handler-selector="[data-categories-filter-clear]"
					data-categories-filter-clear
				>Limpiar Filtros</button>
			</div>
		} else {
			<!-- Categories Grid -->
			<div class="grid grid-cols-table gap-2">
				for _, category := range result.Categories {
					@CategoryTableRow(category)
				}
			</div>
		}
	</div>
	if result.TotalPages > 1 {
		<div hx-swap-oob="innerHTML:#categories-table-pagination">
			<!-- Pagination -->
			if result.TotalPages > 1 {
				@CategoriesPagination(result)
			}
	</div>
	
	<script>
		function openImageSelector(mode, targetField, title, maxSelection) {
			const selectedIds = document.querySelector(`[name="${targetField}"]`).value;
			const params = new URLSearchParams({
				mode: mode,
				target_field: targetField,
				title: title,
				max_selection: maxSelection,
				selected_ids: selectedIds
			});
			
			fetch(`/imagenes/selector?${params}`)
				.then(response => response.text())
				.then(html => {
					document.body.insertAdjacentHTML('beforeend', html);
				})
				.catch(error => {
					console.error('Error loading image selector:', error);
				});
		}
	</script>
}}

templ CategoryTableRow(category *db.Category) {
	<div
		class="relative bg-white rounded-xs shadow-sm overflow-hidden transition-all ease-in-out duration-200 hover:-translate-y-1 hover:shadow-sm active:-translate-y-1 active:shadow-sm select-none group"
		data-categories-table-row={ category.ID }
		data-category-id={ category.ID }
	>
		<div class="absolute top-1 left-1 z-10">
			<input
				type="checkbox"
				name="category-table-selection"
				id={ fmt.Sprintf("category-table-selection-%s", category.ID) }
				value={ category.ID }
				class="h-4.5 w-4.5 rounded-xs bg-stone-50 border border-gray-200"
			/>
		</div>
		<div class="aspect-4/3 relative overflow-hidden">
			if category.DisplayImg != "" {
				<img
					src={ fmt.Sprintf("/static/uploads/%s", category.DisplayImg) }
					alt={ category.Name }
					loading="lazy"
					class="w-full h-full object-cover group-hover:scale-105 group-active:scale-105 transition-transform ease-in-out duration-200"
				/>
			} else {
				<div class="w-full h-full bg-gray-100 flex items-center justify-center group-hover:bg-gray-200 transition-colors ease-in-out duration-200">
					<div class="text-center text-gray-400">
						@components.ImageIcon("w-12 h-12 mx-auto mb-2", nil)
						<p class="text-xs">Sin imagen</p>
					</div>
				</div>
			}
		</div>
		<div class="flex flex-col gap-1 p-2 pt-4">
			<div class="flex gap-1 justify-between">
				<h5 class="tracking-wide font-medium overflow-hidden whitespace-nowrap text-clip" title={ category.Name }>
					{ category.Name }
				</h5>
				<div class="shrink-0 grow-0 basis-auto text-sm text-current/60">
					{ fmt.Sprintf("%d productos", category.ProductCount) }
				</div>
			</div>
			<div class="text-current/60 text-sm font-extralight line-clamp-2" title={ category.Description }>
				{ category.Description }
			</div>
		</div>
		<div class="flex gap-2 p-2 pt-0.5">
			<button
				hx-get={ fmt.Sprintf("/categorias/%s", category.ID) }
				hx-target="#categories-modal"
				hx-indicator="#global-loading-indicator"
				class="flex-1 basis-full bg-gray-700/20 rounded-xs p-2 text-gray-700"
			>
				@components.ViewIcon("w-5 mx-auto", nil)
				<div class="sr-only">Ver categoría</div>
			</button>
			<button
				hx-delete={ fmt.Sprintf("/categorias/%s", category.ID) }
				hx-confirm="¿Seguro que deseas eliminar la categoría? ADVERTENCIA: Esto también eliminará todos los productos de esta categoría."
				hx-indicator="#global-loading-indicator"
				hx-target="#categories-table"
				hx-include='[name="sort"], [name="search"]'
				class="flex-1 basis-full bg-red-700/20 rounded-xs p-2 text-red-700"
			>
				@components.BinIcon("w-5 mx-auto", nil)
				<div class="sr-only">Eliminar categoría</div>
			</button>
		</div>
	</div>
}

templ CategoriesPagination(result *db.CategoryFilterResult) {
	<div class="flex gap-0.5 h-10 items-center">
		<button
			class={
				"w-8 aspect-square",
				templ.KV("opacity-0 invisible", !result.HasPrevious),
			}
			hx-get={ fmt.Sprintf("/categorias?page=%d", result.Page-1) }
			hx-include="[name='search'], [name='sort']"
            hx-indicator="#categories-table-loading"
			hx-target="#categories-table"
		>
			@components.ChevronIcon("w-6 rotate-90", nil)
		</button>
		<!-- Page numbers -->
		<div class="flex-1 basis-full flex justify-center gap-0.5 overflow-x-auto">
			for i, lim:= max(1, result.Page-2), min(result.TotalPages, result.Page+2); i <= lim; i++ {
				<button
					class="w-8 aspect-square rounded-sm disabled:font-medium disabled:text-gray-800 disabled:bg-secondary"
					hx-get={ fmt.Sprintf("/categorias?page=%d", i) }
					hx-target="#categories-table"
					hx-include="[name='search'], [name='sort']"
                    hx-indicator="#categories-table-loading"
					disabled?={ i==result.Page }
				>
					{ fmt.Sprintf("%d", i) }
				</button>
			}
		</div>
		<button
			class={
				"w-8 aspect-square",
				templ.KV("opacity-0 invisible", !result.HasNext),
			}
			hx-get={ fmt.Sprintf("/categorias?page=%d", result.Page+1) }
			hx-include="[name='search'], [name='sort']"
			hx-target="#categories-table"
            hx-indicator="#categories-table-loading"
		>
			@components.ChevronIcon("w-6 -rotate-90", nil)
		</button>
	</div>
}

templ CategoryModal(category *db.Category, err string) {
	<div id="categories-modal-content" class="h-full flex flex-col gap-2 bg-stone-50 rounded-sm shadow p-2">
		<div class="flex-1 flex justify-between items-center">
			<h3 class="text-xl font-medium text-gray-700 tracking-tight flex-1 truncate">
				if err != "" {
					Ocurrió un error al cargar la categoría
				} else {
					{ category.Name }
				}
			</h3>
			<button
				id="categories-modal-close"
				class="p-2 rounded-sm text-gray-700 bg-stone-50"
				data-categories-modal-toggle="close"
				data-click-handler-selector="[data-categories-modal-toggle]"
			>
				@components.TimesIcon("w-8 mx-auto", nil)
			</button>
		</div>
		if err != "" {
			<div class="flex-1 basis-full w-full overflow-hidden">
				<div class="flex flex-col items-center justify-center h-full">
					<p class="text-red-700/70 mx-auto">
						@components.TimesIcon("w-10 mx-auto", nil)
					</p>
					<p class="text-red-700 font-medium text-center mx-auto">{ err }</p>
				</div>
			</div>
		} else {
			@CategoryEditForm(category)
		}
		<div class="flex-1 flex gap-2 justify-end items-center">
			<button
				id="categories-modal-back"
				class="flex gap-1 px-4 py-2 bg-gray-700/20 text-gray-700 font-medium rounded-sm"
				data-categories-modal-toggle="close"
				data-click-handler-selector="[data-categories-modal-toggle]"
			>
				@components.ChevronIcon("w-5 rotate-90 stroke-4", nil)
				Volver
			</button>
			if err == "" {
				<button
					id="categories-modal-delete"
					class="flex gap-1 px-4 py-2 bg-red-700/20 text-red-700 font-medium rounded-sm"
					hx-delete={ fmt.Sprintf("/categorias/%s", category.ID) }
					hx-target="#categories-table"
					hx-include='[name="sort"], [name="search"]'
					hx-indicator="#global-loading-indicator"
					hx-confirm="¿Seguro que deseas eliminar la categoría? ADVERTENCIA: Esto también eliminará todos los productos de esta categoría."
					data-categories-modal-toggle="close"
					data-click-handler-selector="[data-categories-modal-toggle]"
				>
					@components.BinIcon("w-5 mx-auto", nil)
					Eliminar
				</button>
			}
		</div>
	</div>
}

templ CategoryEditForm(category *db.Category) {
	<form
		hx-put={ fmt.Sprintf("/categorias/%s", category.ID) }
		hx-target="#categories-table"
		hx-indicator="#global-loading-indicator"
		class="flex-1 basis-full w-full overflow-auto space-y-4 p-4"
	>
		<div class="space-y-2">
			<label for="category-name" class="block text-sm font-medium text-gray-700">Nombre</label>
			<input
				id="category-name"
				name="name"
				type="text"
				value={ category.Name }
				required
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			/>
		</div>
		<div class="space-y-2">
			<label for="category-slug" class="block text-sm font-medium text-gray-700">Slug</label>
			<input
				id="category-slug"
				name="slug"
				type="text"
				value={ category.Slug }
				required
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			/>
		</div>
		<div class="space-y-2">
			<label for="category-description" class="block text-sm font-medium text-gray-700">Descripción</label>
			<textarea
				id="category-description"
				name="description"
				rows="3"
				required
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			>{ category.Description }</textarea>
		</div>
		<div class="space-y-2">
			<label for="category-long-description" class="block text-sm font-medium text-gray-700">Descripción Larga</label>
			<textarea
				id="category-long-description"
				name="long_description"
				rows="4"
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			>{ category.LongDescription }</textarea>
		</div>
		
		<!-- Images Section -->
		<div class="space-y-4 border-t border-gray-200 pt-4">
			<h3 class="text-md font-medium text-gray-700">Imágenes</h3>
			
			<!-- Hidden inputs for image fields -->
			<input type="hidden" name="header_img" value={ category.HeaderImg } />
			<input type="hidden" name="display_img" value={ category.DisplayImg } />
			
			<!-- Header Image Selector -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Imagen de Encabezado</label>
				<div class="flex items-center space-x-4">
					<button
						type="button"
						onclick="openImageSelector('single', 'header_img', 'Seleccionar Imagen de Encabezado', 1)"
						class="px-3 py-1 text-sm border border-gray-300 text-gray-700 rounded-sm hover:bg-gray-50 transition-colors"
					>
						Seleccionar
					</button>
					<div id="header_img-preview" class="flex space-x-2">
						if category.HeaderImg != "" {
							<div class="relative w-16 h-16 rounded-md overflow-hidden border border-gray-200">
								<img src={ fmt.Sprintf("/static/uploads/%s", category.HeaderImg) } alt="Header" class="w-full h-full object-cover"/>
							</div>
						}
					</div>
				</div>
			</div>
			
			<!-- Display Image Selector -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Imagen de Visualización</label>
				<div class="flex items-center space-x-4">
					<button
						type="button"
						onclick="openImageSelector('single', 'display_img', 'Seleccionar Imagen de Visualización', 1)"
						class="px-3 py-1 text-sm border border-gray-300 text-gray-700 rounded-sm hover:bg-gray-50 transition-colors"
					>
						Seleccionar
					</button>
					<div id="display_img-preview" class="flex space-x-2">
						if category.DisplayImg != "" {
							<div class="relative w-16 h-16 rounded-md overflow-hidden border border-gray-200">
								<img src={ fmt.Sprintf("/static/uploads/%s", category.DisplayImg) } alt="Display" class="w-full h-full object-cover"/>
							</div>
						}
					</div>
				</div>
			</div>
		</div>
		<div class="flex gap-2 pt-4">
			<button
				type="submit"
				class="flex-1 px-4 py-2 bg-accent text-white font-medium rounded-sm hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
			>
				Guardar Cambios
			</button>
		</div>
	</form>
}

templ CategoryCreateModal(err string) {
	<div id="categories-modal-content" class="h-full flex flex-col gap-2 bg-stone-50 rounded-sm shadow p-2">
		<div class="flex-1 flex justify-between items-center">
			<h3 class="text-xl font-medium text-gray-700 tracking-tight flex-1 truncate">
				if err != "" {
					Ocurrió un error al crear la categoría
				} else {
					Nueva Categoría
				}
			</h3>
			<button
				id="categories-modal-close"
				class="p-2 rounded-sm text-gray-700 bg-stone-50"
				data-categories-modal-toggle="close"
				data-click-handler-selector="[data-categories-modal-toggle]"
			>
				@components.TimesIcon("w-8 mx-auto", nil)
			</button>
		</div>
		if err != "" {
			<div class="flex-1 basis-full w-full overflow-hidden">
				<div class="flex flex-col items-center justify-center h-full">
					<p class="text-red-700/70 mx-auto">
						@components.TimesIcon("w-10 mx-auto", nil)
					</p>
					<p class="text-red-700 font-medium text-center mx-auto">{ err }</p>
				</div>
			</div>
		} else {
			@CategoryCreateForm()
		}
		<div class="flex-1 flex gap-2 justify-end items-center">
			<button
				id="categories-modal-back"
				class="flex gap-1 px-4 py-2 bg-gray-700/20 text-gray-700 font-medium rounded-sm"
				data-categories-modal-toggle="close"
				data-click-handler-selector="[data-categories-modal-toggle]"
			>
				@components.ChevronIcon("w-5 rotate-90 stroke-4", nil)
				Cancelar
			</button>
		</div>
	</div>
}

templ CategoryCreateForm() {
	<form
		hx-post="/categorias/nueva"
		hx-target="#categories-table"
		hx-indicator="#global-loading-indicator"
		hx-include='[name="search"], [name="sort"]'
		class="flex-1 basis-full w-full overflow-auto space-y-4 p-4"
	>
		<div class="space-y-2">
			<label for="category-create-name" class="block text-sm font-medium text-gray-700">Nombre</label>
			<input
				id="category-create-name"
				name="name"
				type="text"
				required
				placeholder="Nombre de la categoría"
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			/>
		</div>
		<div class="space-y-2">
			<label for="category-create-description" class="block text-sm font-medium text-gray-700">Descripción</label>
			<textarea
				id="category-create-description"
				name="description"
				rows="3"
				required
				placeholder="Descripción breve de la categoría"
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			></textarea>
		</div>
		<div class="space-y-2">
			<label for="category-create-long-description" class="block text-sm font-medium text-gray-700">Descripción Larga</label>
			<textarea
				id="category-create-long-description"
				name="long_description"
				rows="4"
				placeholder="Descripción detallada (opcional)"
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			></textarea>
		</div>
		
		<!-- Images Section -->
		<div class="space-y-4 border-t border-gray-200 pt-4">
			<h3 class="text-md font-medium text-gray-700">Imágenes</h3>
			
			<!-- Hidden inputs for image fields -->
			<input type="hidden" name="header_img" value="" />
			<input type="hidden" name="display_img" value="" />
			
			<!-- Header Image Selector -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Imagen de Encabezado</label>
				<div class="flex items-center space-x-4">
					<button
						type="button"
						onclick="openImageSelector('single', 'header_img', 'Seleccionar Imagen de Encabezado', 1)"
						class="px-3 py-1 text-sm border border-gray-300 text-gray-700 rounded-sm hover:bg-gray-50 transition-colors"
					>
						Seleccionar
					</button>
					<div id="header_img-preview" class="flex space-x-2">
						<!-- Selected image preview will appear here -->
					</div>
				</div>
			</div>
			
			<!-- Display Image Selector -->
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Imagen de Visualización</label>
				<div class="flex items-center space-x-4">
					<button
						type="button"
						onclick="openImageSelector('single', 'display_img', 'Seleccionar Imagen de Visualización', 1)"
						class="px-3 py-1 text-sm border border-gray-300 text-gray-700 rounded-sm hover:bg-gray-50 transition-colors"
					>
						Seleccionar
					</button>
					<div id="display_img-preview" class="flex space-x-2">
						<!-- Selected image preview will appear here -->
					</div>
				</div>
			</div>
		</div>
		<div class="flex gap-2 pt-4">
			<button
				type="submit"
				class="flex-1 px-4 py-2 bg-accent text-white font-medium rounded-sm hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
			>
				Crear Categoría
			</button>
		</div>
	</form>
}


