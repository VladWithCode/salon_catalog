package dashboard

import (
	"fmt"
	"github.com/vladwithcode/salon_catalog/internal/db"
	"github.com/vladwithcode/salon_catalog/internal/templates/components"
)

templ ProductsTable(result *db.ProductFilterResult) {
	<span id="products-table-count" hx-swap-oob="true">({ fmt.Sprintf("%d", len(result.Products)) }/ { fmt.Sprintf("%d", result.Total) })</span>
	<div class="flex flex-col p-1 mx-auto">
		if result.HasError {
			<div class="flex-1 flex items-center justify-center gap-4 p-4">
				<h3 class="text-lg text-red-700 font-semibold">Algo salió mal</h3>
				<button
					type="button"
					class="text-lg underline underline-offset-2 text-accent font-bold tracking-wide"
					hx-get="/panel/productos/table"
					hx-target="#products-table"
					hx-params="none"
					data-click-handler-selector="[data-products-filter-clear]"
					data-products-filter-clear
				>Limpiar Filtros</button>
			</div>
		}
		if len(result.Products) == 0 {
			<div class="text-center p-4 space-y-2">
				<h3 class="">No se encontraron productos que coincidan con tu búsqueda</h3>
				<button
					type="button"
					class="text-lg underline underline-offset-2 text-accent font-bold tracking-wide"
					hx-get="/panel/productos/table"
					hx-target="#products-table"
					hx-params="none"
					data-click-handler-selector="[data-products-filter-clear]"
					data-products-filter-clear
				>Limpiar Filtros</button>
			</div>
		} else {
			<!-- Products Grid -->
			<div class="grid grid-cols-table gap-2">
				for _, product := range result.Products {
					@ProductTableRow(product)
				}
			</div>
		}
	</div>
	if result.TotalPages > 1 {
		<div hx-swap-oob="innerHTML:#products-table-pagination">
			<!-- Pagination -->
			if result.TotalPages > 1 {
				@ProductsPagination(result)
			}
		</div>
	}
}

templ ProductTableRow(product *db.Product) {
	<div
		class="relative bg-white rounded-xs shadow-sm overflow-hidden transition-all ease-in-out duration-200 hover:-translate-y-1 hover:shadow-sm active:-translate-y-1 active:shadow-sm select-none group"
		data-products-table-row={ product.ID }
		data-product-id={ product.ID }
	>
		<div class="absolute top-1 left-1 z-10">
			<input
				type="checkbox"
				name="product-table-selection"
				id={ fmt.Sprintf("product-table-selection-%s", product.ID) }
				value={ product.ID }
				class="h-4.5 w-4.5 rounded-xs bg-stone-50 border border-gray-200"
			/>
		</div>
		<div class="aspect-4/3 relative overflow-hidden">
			if product.MainImg != "" {
				<img
					src={ fmt.Sprintf("/static/uploads/%s", product.MainImg) }
					alt={ product.Name }
					loading="lazy"
					class="w-full h-full object-cover group-hover:scale-105 group-active:scale-105 transition-transform ease-in-out duration-200"
				/>
			} else {
				<div class="w-full h-full bg-gray-100 flex items-center justify-center group-hover:bg-gray-200 transition-colors ease-in-out duration-200">
					<div class="text-center text-gray-400">
						@components.ImageIcon("w-12 h-12 mx-auto mb-2", nil)
						<p class="text-xs">Sin imagen</p>
					</div>
				</div>
			}
		</div>
		<div class="flex flex-col gap-1 p-2 pt-4">
			<div class="flex gap-1 justify-between">
				<h5 class="tracking-wide font-medium overflow-hidden whitespace-nowrap text-clip" title={ product.Name }>
					{ product.Name }
				</h5>
				<div class="shrink-0 grow-0 basis-auto text-sm text-current/60">
					if product.Available {
						<span class="text-green-600">Disponible</span>
					} else {
						<span class="text-red-600">No disponible</span>
					}
				</div>
			</div>
			<div class="text-current/60 text-sm font-extralight line-clamp-2" title={ product.Description }>
				{ product.Description }
			</div>
			<div class="flex justify-between items-center text-xs text-current/60">
				<span>{ product.Category }</span>
				<span>Cantidad: { fmt.Sprintf("%d", product.Quantity) }</span>
			</div>
		</div>
		<div class="flex gap-2 p-2 pt-0.5">
			<button
				hx-get={ fmt.Sprintf("/panel/productos/modal/%s", product.ID) }
				hx-target="#products-modal"
				hx-indicator="#global-loading-indicator"
				class="flex-1 basis-full bg-gray-700/20 rounded-xs p-2 text-gray-700"
			>
				@components.EditIcon("w-5 mx-auto", nil)
				<div class="sr-only">Editar/Ver producto</div>
			</button>
			<button
				hx-delete={ fmt.Sprintf("/panel/productos/%s", product.ID) }
				hx-confirm="¿Seguro que deseas eliminar el producto?"
				hx-indicator="#global-loading-indicator"
				hx-target="#products-table"
				hx-include='[name="sort"], [name="search"]'
				class="flex-1 basis-full bg-red-700/20 rounded-xs p-2 text-red-700"
			>
				@components.BinIcon("w-5 mx-auto", nil)
				<div class="sr-only">Eliminar producto</div>
			</button>
		</div>
	</div>
}

templ ProductsPagination(result *db.ProductFilterResult) {
	<div class="flex gap-0.5 h-10 items-center">
		<button
			class={
				"w-8 aspect-square",
				templ.KV("opacity-0 invisible", !result.HasPrevious),
			}
			hx-get={ fmt.Sprintf("/panel/productos/table?page=%d", result.Page-1) }
			hx-include="[name='search'], [name='sort']"
			hx-indicator="#products-table-loading"
			hx-target="#products-table"
		>
			@components.ChevronIcon("w-6 rotate-90", nil)
		</button>
		<!-- Page numbers -->
		<div class="flex-1 basis-full flex justify-center gap-0.5 overflow-x-auto">
			for i, lim:= max(1, result.Page-2), min(result.TotalPages, result.Page+2); i <= lim; i++ {
				<button
					class="w-8 aspect-square rounded-sm disabled:font-medium disabled:text-gray-800 disabled:bg-secondary"
					hx-get={ fmt.Sprintf("/panel/productos/table?page=%d", i) }
					hx-target="#products-table"
					hx-include="[name='search'], [name='sort']"
					hx-indicator="#products-table-loading"
					disabled?={ i==result.Page }
				>
					{ fmt.Sprintf("%d", i) }
				</button>
			}
		</div>
		<button
			class={
				"w-8 aspect-square",
				templ.KV("opacity-0 invisible", !result.HasNext),
			}
			hx-get={ fmt.Sprintf("/panel/productos/table?page=%d", result.Page+1) }
			hx-include="[name='search'], [name='sort']"
			hx-target="#products-table"
			hx-indicator="#products-table-loading"
		>
			@components.ChevronIcon("w-6 -rotate-90", nil)
		</button>
	</div>
}

templ ProductModal(product *db.Product, availableCategories []db.Category, err string) {
	<div id="products-modal-content" class="h-full lg:max-w-4xl xl:max-w-7xl flex flex-col bg-stone-50 rounded-sm shadow p-2 mx-auto">
		<div class="flex-1 flex justify-between items-center px-2 border-b border-gray-200">
			<h3 class="text-xl font-medium text-gray-700 tracking-tight flex-1 truncate">
				if err != "" {
					Ocurrió un error al cargar el producto
				} else {
					{ product.Name }
				}
			</h3>
			<button
				id="products-modal-close"
				class="p-2 rounded-sm text-gray-700 bg-stone-50"
				data-products-modal-toggle="close"
				data-click-handler-selector="[data-products-modal-toggle]"
			>
				@components.TimesIcon("w-8 mx-auto", nil)
			</button>
		</div>
		<div id="products-modal-tab-selector" class="flex-1 basis-16 flex gap-2 p-2 bg-gray-200 rounded-sm overflow-x-auto overflow-y-hidden">
			<button
				data-products-modal-tab="products-modal-form"
				data-click-handler-selector="[data-products-modal-tab]"
				class="flex-1 basis-1/3 p-2 bg-gray-700 rounded-sm text-light cursor-pointer hover:bg-gray-700/80 hover:text-light"
			>
				Datos
			</button>
			<div class="w-px h-4/5 bg-gray-700/60 my-auto"></div>
			<button
				data-products-modal-tab="products-modal-images"
				data-click-handler-selector="[data-products-modal-tab]"
				class="flex-1 basis-1/3 p-2 bg-gray-700/0 rounded-sm text-gray-700 cursor-pointer hover:bg-gray-700/80 hover:text-light"
			>
				Imágenes
			</button>
			<div class="w-px h-4/5 bg-gray-700/60 my-auto"></div>
			<button
				data-products-modal-tab="products-modal-qrcode"
				data-click-handler-selector="[data-products-modal-tab]"
				class="flex-1 basis-1/3 p-2 bg-gray-700/0 rounded-sm text-gray-700 cursor-pointer hover:bg-gray-700/80 hover:text-light"
			>
				QR Code
			</button>
		</div>
		if err != "" {
			<div class="flex-1 basis-full w-full overflow-hidden mt-2">
				<div class="flex flex-col items-center justify-center h-full">
					<p class="text-red-700/70 mx-auto">
						@components.TimesIcon("w-10 mx-auto", nil)
					</p>
					<p class="text-red-700 font-medium text-center mx-auto">{ err }</p>
				</div>
			</div>
		} else {
			<div class="flex-1 basis-full grid grid-cols-1 grid-rows-1 overflow-hidden">
				<div
					id="products-modal-form"
					class="relative col-start-1 row-start-1 bg-gray-50 h-full overflow-y-auto overflow-x-hidden flex flex-col z-10"
				>
					@ProductEditForm(product, availableCategories)
				</div>
				<div
					id="products-modal-images"
					class="relative col-start-1 row-start-1 bg-gray-50 h-full overflow-y-auto overflow-x-hidden translate-x-60 opacity-0 flex flex-col z-0 pointer-events-none"
				>
					@ProductImagesTab(product, &ProductImagesTabUpdateData{})
				</div>
				<div
					id="products-modal-qrcode"
					class="relative col-start-1 row-start-1 bg-gray-50 h-full overflow-y-auto overflow-x-hidden translate-x-60 opacity-0 flex flex-col z-0 pointer-events-none"
				>
					@ProductQRCode(product, ProductQRCodeState{})
				</div>
			</div>
		}
		<div class="flex-1 flex gap-2 justify-end items-center my-2">
			<button
				id="products-modal-back"
				class="flex gap-1 px-4 py-2 bg-gray-700/20 text-gray-700 font-medium rounded-sm"
				data-products-modal-toggle="close"
				data-click-handler-selector="[data-products-modal-toggle]"
			>
				@components.ChevronIcon("w-5 rotate-90 stroke-4", nil)
				Volver
			</button>
			if err == "" {
				<button
					id="products-modal-delete"
					class="flex gap-1 px-4 py-2 bg-red-700/20 text-red-700 font-medium rounded-sm"
					hx-delete={ fmt.Sprintf("/panel/productos/%s", product.ID) }
					hx-target="#products-table"
					hx-include='[name="sort"], [name="search"]'
					hx-indicator="#global-loading-indicator"
					hx-confirm="¿Seguro que deseas eliminar el producto?"
					data-products-modal-toggle="close"
					data-click-handler-selector="[data-products-modal-toggle]"
				>
					@components.BinIcon("w-5 mx-auto", nil)
					Eliminar
				</button>
			}
		</div>
	</div>
}

templ ProductEditForm(product *db.Product, availableCategories []db.Category) {
	<form
		hx-put={ fmt.Sprintf("/panel/productos/%s", product.ID) }
		hx-target="#products-table"
		hx-indicator="#global-loading-indicator"
		class="flex-1 basis-full w-full overflow-auto space-y-4 p-4"
	>
		<div class="space-y-2">
			<label for="product-name" class="block text-sm font-medium text-gray-700">Nombre</label>
			<input
				id="product-name"
				name="name"
				type="text"
				value={ product.Name }
				required
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
				data-products-modal-input="name"
			/>
		</div>
		<div class="space-y-2">
			<label for="product-slug" class="block text-sm font-medium text-gray-700">Nombre de Catálogo</label>
			<input
				id="product-slug"
				name="slug"
				type="text"
				readonly
				value={ product.Slug }
				required
				class="block w-full"
				data-products-modal-input="slug"
			/>
		</div>
		<div class="space-y-2">
			<label for="product-description" class="block text-sm font-medium text-gray-700">Descripción</label>
			<textarea
				id="product-description"
				name="description"
				rows="3"
				required
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			>{ product.Description }</textarea>
		</div>
		<div class="space-y-2">
			<label for="product-long-description" class="block text-sm font-medium text-gray-700">Descripción Larga</label>
			<textarea
				id="product-long-description"
				name="long_description"
				rows="4"
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
			>{ product.LongDescription }</textarea>
		</div>
		<div class="space-y-2">
			<label for="product-category" class="block text-sm font-medium text-gray-700">Categoría</label>
			<select
				id="product-category"
				name="category"
				required
				class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white focus:outline-none focus:ring-1 focus:ring-accent focus:border-accent"
			>
				<option value="">Seleccionar categoría</option>
				@ProductCategoryOptions(product.CategoryID, availableCategories)
			</select>
		</div>
		<div class="grid grid-cols-2 gap-4">
			<div class="space-y-2">
				<label for="product-quantity" class="block text-sm font-medium text-gray-700">Cantidad</label>
				<input
					id="product-quantity"
					name="quantity"
					type="number"
					min="0"
					value={ fmt.Sprintf("%d", product.Quantity) }
					class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
				/>
			</div>
			<div class="space-y-2">
				<label class="block text-sm font-medium text-gray-700">Disponibilidad</label>
				<div class="flex items-center">
					<input
						id="product-available"
						name="available"
						type="checkbox"
						checked?={ product.Available }
						class="h-4 w-4 text-accent focus:ring-accent border-gray-300 rounded"
					/>
					<label for="product-available" class="ml-2 block text-sm text-gray-900">
						Producto disponible
					</label>
				</div>
			</div>
		</div>
		<div class="flex gap-2 pt-4">
			<button
				type="submit"
				class="flex-1 px-4 py-2 bg-accent text-white font-medium rounded-sm hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
			>
				Guardar Cambios
			</button>
		</div>
	</form>
}

type ProductImagesTabUpdateData struct {
	MainImgFilename string   `json:"main_img_filename"`
	MainImgID       string   `json:"main_img_id"`
	Gallery         []string `json:"gallery"`
	GalleryIDs      []string `json:"gallery_ids"`
}

templ ProductImagesTab(product *db.Product, updateData *ProductImagesTabUpdateData) {
	<div
		class="flex-1 space-y-4 py-6 px-2 md:px-4 text-gray-700 overflow-y-auto overflow-x-hidden"
		id="products-modal-images-tab"
	>
		<div class="shrink-0 grow-0 basis-auto">
			<h3 class="text-lg font-medium line-clamp-1 text-ellipsis">Imágenes de { product.Name }</h3>
			<p class="text-current/60">Selecciona las imágenes que deseas incluir en el producto: { product.Name }</p>
		</div>
		@templ.Fragment("mainImgSection") {
			<div id="product-modal-images-main" class="flex-1 basis-full space-y-4 overflow-hidden">
				{{ imgFileName := ExtractProductImageFilename(product, updateData) }}
				<div class="flex-1 basis-full space-y-4">
					<h4 class="shrink-0 grow-0 text-lg lg:text-2xl tracking-tight text-dark/80">Imágen principal</h4>
					<div class="lg:grid lg:grid-cols-[20rem_1fr] lg:grid-rows-[20rem] lg:gap-4 space-y-4 lg:space-y-0">
						<div class="lg:col-start-2 lg:row-start-1 lg:justify-self-start max-w-md md:basis-1/2 md:max-w-[initial] space-y-2">
							<button
								id="products-modal-images-select-main"
								class="flex items-center justify-center gap-4 w-full py-2 px-6 rounded-lg bg-gray-700/90 text-light scale-100 hover:bg-gray-700 active:bg-gray-700 active:scale-95 transition-[transform,_background] cursor-pointer"
								hx-get="/imagenes/selector"
								hx-vals={ (&ImageSelectorConfig{
                                    Mode:           "single",
                                    UpdateEndpoint: fmt.Sprintf("/panel/productos/%s/main_img", product.ID),
                                    Title:          "Seleccionar la imagen principal para " + product.Name,
                                    MaxSelection:   1,
                                    SelectedIds:    []string{product.MainImgID},
                                    SuccessTarget:  "#product-modal-images-main",
                                }).ToJSONString() }
								hx-target="body"
								hx-swap="beforeend"
								hx-indicator="#global-loading-indicator"
							>
								@components.ImageIcon("w-5", nil)
								<span class="block">Seleccionar imágen principal</span>
							</button>
							<button
								id="products-modal-images-unset-main"
								class="flex items-center justify-center gap-4 w-full py-2 px-4 rounded-lg text-red-700 text-light scale-100 bg-red-100 hover:bg-red-200 active:bg-red-200 active:scale-95 transition-[transform,_background] cursor-pointer"
								hx-delete={ fmt.Sprintf("/panel/productos/%s/main_img", product.ID) }
								hx-target="#product-modal-images-main"
								hx-indicator="#global-loading-indicator"
								hx-confirm="¿Seguro que deseas eliminar la imagen principal?"
							>
								@components.BinIcon("w-5", nil)
								<span class="block">Quitar imágen principal</span>
							</button>
						</div>
						<div class="w-full lg:h-full lg:col-start-1 lg:row-start-1 lg:place-self-center lg:flex lg:justify-center overflow-hidden">
							if imgFileName != "" {
								<button
									type="button"
									class="lg:h-full w-full mx-auto"
									data-click-handler-selector="product-modal-images-btn"
								>
									<img
										src={ fmt.Sprintf("/static/uploads/%s", imgFileName) }
										alt={ product.Name }
										class="w-full h-full object-cover rounded-lg drop-shadow-md"
									/>
								</button>
							} else {
								<div class="flex flex-col items-center justify-center gap-4 w-full lg:h-full py-16 mx-auto">
									@components.ImageIcon("w-12 h-12", nil)
									<p class="text-center text-gray-400">No se ha seleccionado una imagen</p>
								</div>
							}
						</div>
					</div>
				</div>
			</div>
		}
		<div id="products-modal-images-gallery" class="flex-1 grid gap-4 overflow-auto">
			@templ.Fragment("gallerySection") {
				<h4 class="text-lg tracking-tight text-dark/80">Galería</h4>
				<div class="max-w-md space-y-2">
					<button
						id="products-modal-images-select-gallery"
						class="flex items-center justify-center gap-4 w-full py-2 px-4 rounded-lg bg-gray-700/90 text-light scale-100 hover:bg-gray-700 active:bg-gray-700 active:scale-95 transition-[transform,_background] cursor-pointer"
						hx-get="/imagenes/selector"
						hx-vals={ (&ImageSelectorConfig{
                            Mode:           "multiple",
                            UpdateEndpoint: fmt.Sprintf("/panel/productos/%s/gallery", product.ID),
                            Title:          "Seleccionar imágenes para la galería de " + product.Name,
                            MaxSelection:   10,
                            SelectedIds:    product.GalleryIDs,
                            SuccessTarget:  "#products-modal-images-gallery",
                        }).ToJSONString() }
						hx-target="body"
						hx-swap="beforeend"
						hx-indicator="#global-loading-indicator"
					>
						@components.ImageIcon("w-5", nil)
						<span class="block">Seleccionar imágenes</span>
					</button>
					<button
						id="products-modal-images-unset-main"
						class="flex items-center justify-center gap-4 w-full py-2 px-4 rounded-lg text-red-700 text-light scale-100 bg-red-100 hover:bg-red-200 active:bg-red-200 active:scale-95 transition-[transform,_background] cursor-pointer"
						hx-delete={ fmt.Sprintf("/panel/productos/%s/gallery", product.ID) }
						hx-target="#products-modal-images-gallery"
						hx-indicator="#global-loading-indicator"
						hx-confirm="¿Seguro que deseas eliminar las imágenes de la galería?"
					>
						@components.BinIcon("w-5", nil)
						<span class="block">Quitar imágenes</span>
					</button>
				</div>
				<div id="products-modal-images-grid" class="h-full grid grid-cols-2 gap-4">
					if len(product.Gallery) > 0 {
						for _, image := range product.Gallery {
							<div class="relative col-span-1 aspect-square rounded-md overflow-hidden border border-gray-200">
								<button
									type="button"
									class="w-full h-full"
									data-click-handler-selector="product-modal-images-btn"
								>
									<img
										src={ fmt.Sprintf("/static/uploads/%s", image) }
										alt={ product.Name }
										class="w-full h-full object-cover"
									/>
								</button>
							</div>
						}
					} else {
						<div class="col-span-full flex flex-col items-center justify-center gap-4 w-full h-full py-16 mx-auto">
							@components.ImageIcon("w-12 h-12", nil)
							<p class="text-center text-gray-400">No se han seleccionado imágenes</p>
						</div>
					}
				</div>
			}
		</div>
	</div>
}

func ExtractProductImageFilename(product *db.Product, updateData *ProductImagesTabUpdateData) string {
	if updateData.MainImgFilename != "" {
		return updateData.MainImgFilename
	} else {
		return product.MainImg
	}
}

type ProductQRCodeState struct {
	HasError   bool
	ErrorMsg   string
	HasSuccess bool
	SuccessMsg string
}

templ ProductQRCode(product *db.Product, state ProductQRCodeState) {
	<div
		class="relative z-0 flex-1 flex flex-col text-gray-700 gap-4"
		id="products-modal-qrcode-tab"
	>
		@templ.Fragment("qrcodeTabError") {
			if state.HasError {
				<div
					id="products-modal-qrcode-error"
					class="absolute top-4 inset-x-0 z-30 flex gap-4 items-center justify-center w-full bg-red-50 border-l-4 border-red-500 rounded-lg px-4 py-2"
				>
					<div class="rounded-full bg-red-700 text-red-100 p-0.5">
						@components.TimesIcon("w-8 mx-auto", nil)
					</div>
					<p class="text-red-700 font-medium text-center mx-auto">{ state.ErrorMsg }</p>
					<button
						type="button"
						class="text-sm underline underline-offset-2 text-accent font-bold tracking-wide"
						data-click-handler-selector="close-products-modal-qrcode-error"
					>
						@components.TimesIcon("w-6 mx-auto", nil)
					</button>
				</div>
			}
		}
		@templ.Fragment("qrcodeTabSuccess") {
			if state.HasSuccess {
				<div class="absolute top-4 inset-x-0 z-30 flex gap-4 items-center justify-center w-full bg-green-50 border-l-4 border-green-500 rounded-lg px-4 py-2">
					<div class="rounded-full bg-green-700 text-green-100 p-0.5">
						@components.CheckIcon("w-8 mx-auto", nil)
					</div>
					<p class="text-green-700 font-medium text-center mx-auto">{ state.SuccessMsg }</p>
					<button
						type="button"
						class="text-sm underline underline-offset-2 text-accent font-bold tracking-wide"
						data-click-handler-selector="close-products-modal-qrcode-success"
					>
						@components.TimesIcon("w-6 mx-auto", nil)
					</button>
				</div>
			}
		}
		<div class="flex-1 pt-4 px-4 lg:grow-0">
			<h3 class="text-lg font-medium line-clamp-2 text-ellipsis">Codigo QR de { product.Name }</h3>
			<p class="text-current/60">Scanea, descarga o comparte este código de acceso directo al producto: { product.Name }</p>
		</div>
		<div class="space-y-2 lg:flex">
			<div id="products-modal-qrcode-img" class="flex-1 basis-full lg:flex-auto lg:basis-1/2">
				if product.QRCodeFilename == "" {
					<div class="flex flex-col gap-2 items-center justify-center h-full">
						<p class="text-red-700/70 mx-auto">
							@components.TimesIcon("w-24 mx-auto", nil)
						</p>
						<p class="text-red-700 text-xl font-medium text-center mx-auto">
							Aún no se ha generado el código QR
						</p>
					</div>
				} else {
					<img
						src={ fmt.Sprintf("/static/qrcodes/%s", product.QRCodeFilename) }
						alt={ product.Name }
						class="w-full h-full object-contain rounded-lg drop-shadow-md"
					/>
				}
			</div>
			<div class="flex-1 flex flex-col gap-2 px-4 lg:flex-auto lg:basis-1/2" hx-ext="response-targets">
				<button
					id="products-generate-qrcode-btn"
					class="flex items-center justify-center gap-4 bg-gray-700 text-light px-4 py-2 rounded-sm"
					hx-put={ fmt.Sprintf("/panel/qrcodes/productos/%s", product.ID) }
					hx-target="#products-modal-qrcode-tab"
					hx-target-error="#products-modal-qrcode-error"
					hx-swap="outerHTML"
					hx-indicator="#global-loading-indicator"
				>
					@components.QrCodeIcon("w-5", nil)
					<span class="block">Generar QR</span>
				</button>
				<a
					href={ fmt.Sprintf("/static/qrcodes/%s", product.QRCodeFilename) }
					class={
						"flex items-center justify-center gap-4 px-4 py-2 text-light bg-accent rounded-sm ",
						templ.KV(
							"opacity-80 brightness-90 cursor-not-allowed",
							product.QRCodeFilename == "",
						),
					}
					download={ product.Name }
				>
					@components.DownloadIcon("w-5", nil)
					<span class="block">Descargar</span>
				</a>
			</div>
		</div>
	</div>
}

templ ProductCreateModal(availableCategories []db.Category, err string) {
	<div id="products-modal-content" class="h-full lg:max-w-4xl 2xl:max-w-[90%] flex 2xl:grid flex-col 2xl:grid-cols-2 2xl:grid-rows-[auto_1fr_auto] gap-2 bg-stone-50 rounded-sm shadow p-2 mx-auto">
		<div class="flex-1 flex justify-between items-center 2xl:col-span-full 2xl:rows-start-1">
			<h3 class="text-xl font-medium text-gray-700 tracking-tight flex-1 truncate px-4">
				if err != "" {
					Ocurrió un error al crear el producto
				} else {
					Nuevo Producto
				}
			</h3>
			<button
				id="products-modal-close"
				class="p-2 rounded-sm text-gray-700 bg-stone-50"
				data-products-modal-toggle="close"
				data-click-handler-selector="[data-products-modal-toggle]"
			>
				@components.TimesIcon("w-8 mx-auto", nil)
			</button>
		</div>
		if err != "" {
			<div class="flex-1 basis-full w-full overflow-hidden 2xl:col-span-full 2xl:row-start-2">
				<div class="flex flex-col items-center justify-center h-full">
					<p class="text-red-700/70 mx-auto">
						@components.TimesIcon("w-10 mx-auto", nil)
					</p>
					<p class="text-red-700 font-medium text-center mx-auto">{ err }</p>
				</div>
			</div>
		} else {
			@ProductCreateForm(availableCategories)
		}
		<div class="flex-1 flex gap-2 justify-end items-center 2xl:col-span-full 2xl:row-start-3">
			<button
				id="products-modal-back"
				class="flex gap-1 px-4 py-2 bg-gray-700/20 text-gray-700 font-medium rounded-sm"
				data-products-modal-toggle="close"
				data-click-handler-selector="[data-products-modal-toggle]"
			>
				@components.ChevronIcon("w-5 rotate-90 stroke-4", nil)
				Cancelar
			</button>
		</div>
	</div>
}

templ ProductCreateForm(availableCategories []db.Category) {
	<form
		hx-post="/panel/productos/nuevo"
		hx-target="#products-table"
		hx-indicator="#global-loading-indicator"
		hx-include='[name="search"], [name="sort"]'
		class="2xl:col-span-full 2xl:row-start-2 2xl:grid 2xl:grid-cols-subgrid 2xl:auto-rows-auto flex-1 basis-full w-full overflow-auto space-y-4 p-4"
	>
		<div class="2xl:col-start-1">
			<div class="space-y-2">
				<label for="product-create-name" class="block text-sm font-medium text-gray-700">Nombre</label>
				<input
					id="product-create-name"
					name="name"
					type="text"
					required
					placeholder="Nombre del producto"
					class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
				/>
			</div>
			<div class="space-y-2">
				<label for="product-create-description" class="block text-sm font-medium text-gray-700">Descripción</label>
				<textarea
					id="product-create-description"
					name="description"
					rows="3"
					required
					placeholder="Descripción breve del producto"
					class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
				></textarea>
			</div>
			<div class="space-y-2">
				<label for="product-create-long-description" class="block text-sm font-medium text-gray-700">Descripción Larga</label>
				<textarea
					id="product-create-long-description"
					name="long_description"
					rows="4"
					placeholder="Descripción detallada (opcional)"
					class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
				></textarea>
			</div>
			<div class="space-y-2">
				<label for="product-create-category" class="block text-sm font-medium text-gray-700">Categoría</label>
				<select
					id="product-create-category"
					name="category"
					required
					class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white focus:outline-none focus:ring-1 focus:ring-accent focus:border-accent"
				>
					<option value="">Seleccionar categoría</option>
					@ProductCategoryOptions("", availableCategories)
				</select>
			</div>
			<div class="grid grid-cols-2 gap-4">
				<div class="space-y-2">
					<label for="product-create-quantity" class="block text-sm font-medium text-gray-700">Cantidad</label>
					<input
						id="product-create-quantity"
						name="quantity"
						type="number"
						min="0"
						value="0"
						class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
					/>
				</div>
				<div class="space-y-2">
					<label class="block text-sm font-medium text-gray-700">Disponibilidad</label>
					<div class="flex items-center">
						<input
							id="product-create-available"
							name="available"
							type="checkbox"
							checked
							class="h-4 w-4 text-accent focus:ring-accent border-gray-300 rounded"
						/>
						<label for="product-create-available" class="ml-2 block text-sm text-gray-900">
							Producto disponible
						</label>
					</div>
				</div>
			</div>
		</div>
		<div class="2xl:col-span-full flex gap-2 pt-4">
			<button
				type="submit"
				class="flex-1 px-4 py-2 bg-accent text-white font-medium rounded-sm hover:bg-accent/90 focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2"
			>
				Crear Producto
			</button>
		</div>
	</form>
}

templ ProductCategoryOptions(selectedID string, availableCategories []db.Category) {
	// Load categories from database - this is a simplified version
	// In a real implementation, you'd pass categories as a parameter
	for _, category := range availableCategories {
		<option value={ category.ID } selected?={ selectedID == category.ID }>{ category.Name }</option>
	}
}
