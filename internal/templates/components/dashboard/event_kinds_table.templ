package dashboard

import (
	"fmt"
	"github.com/vladwithcode/salon_catalog/internal/db"
	"github.com/vladwithcode/salon_catalog/internal/templates/components"
)

templ EventKindsTable(result *db.EventKindFilterResult) {
	<span id="event-kinds-table-count" hx-swap-oob="true">({ fmt.Sprintf("%d", len(result.EventKinds)) }/ { fmt.Sprintf("%d", result.Total) })</span>
	<div class="max-w-screen-xl flex flex-col p-1 mx-auto">
		if result.HasError {
			<div class="flex-1 flex items-center justify-center gap-4 p-4">
				<h3 class="text-lg text-red-700 font-semibold">Algo salió mal</h3>
				<button
					type="button"
					class="text-lg underline underline-offset-2 text-accent font-bold tracking-wide"
					hx-get="/panel/tipos-eventos/table"
					hx-target="#event-kinds-table"
					hx-params="none"
					data-click-handler-selector="[data-event-kinds-filter-clear]"
					data-event-kinds-filter-clear
				>Limpiar Filtros</button>
			</div>
		}
		if len(result.EventKinds) == 0 {
			<div class="text-center p-4 space-y-2">
				<h3 class="">No se encontraron tipos de eventos que coincidan con tu búsqueda</h3>
				<button
					type="button"
					class="text-lg underline underline-offset-2 text-accent font-bold tracking-wide"
					hx-get="/panel/tipos-eventos/table"
					hx-target="#event-kinds-table"
					hx-params="none"
					data-click-handler-selector="[data-event-kinds-filter-clear]"
					data-event-kinds-filter-clear
				>Limpiar Filtros</button>
			</div>
		} else {
			<!-- Event Kinds Grid -->
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-2 2xl:grid-cols-3 gap-4">
				for _, eventKind := range result.EventKinds {
					@EventKindTableRow(eventKind)
				}
			</div>
		}
	</div>
}

templ EventKindTableRow(eventKind *db.EventKind) {
	<div
		class="relative bg-white rounded-xs shadow-sm overflow-hidden transition-all ease-in-out duration-200 hover:-translate-y-1 hover:shadow-md active:-translate-y-1 active:shadow-md select-none group border border-gray-100"
		data-event-kinds-table-row={ eventKind.ID }
		data-event-kind-id={ eventKind.ID }
	>
		<div class="p-4">
			<div class="flex flex-col gap-2">
				<div class="flex items-start justify-between">
					<h5 class="text-lg font-medium text-gray-900 tracking-wide" title={ eventKind.Name }>
						{ eventKind.Name }
					</h5>
					<div class="flex gap-1 ml-2">
						<button
							class="p-1.5 text-gray-400 hover:text-blue-600 hover:bg-blue-50 rounded-xs transition-colors"
							hx-get={ fmt.Sprintf("/panel/tipos-eventos/modal/%s", eventKind.ID) }
							hx-target="#event-kinds-modal"
							hx-indicator="#event-kinds-table-loading"
							title="Editar tipo de evento"
						>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
							</svg>
						</button>
						<button
							class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-xs transition-colors"
							hx-delete={ fmt.Sprintf("/panel/tipos-eventos/%s", eventKind.ID) }
							hx-target="#event-kinds-table"
							hx-indicator="#event-kinds-table-loading"
							hx-confirm="¿Estás seguro de que quieres eliminar este tipo de evento?"
							title="Eliminar tipo de evento"
						>
							@components.BinIcon("w-4 h-4", nil)
						</button>
					</div>
				</div>
				<div class="text-sm text-gray-600">
					if eventKind.Description != "" {
						<p class="line-clamp-3">{ eventKind.Description }</p>
					} else {
						<p class="text-gray-400 italic">Sin descripción</p>
					}
				</div>
			</div>
		</div>
		<div class="absolute inset-0 bg-gradient-to-t from-transparent to-transparent group-hover:from-blue-50/20 group-hover:to-transparent transition-all duration-200 pointer-events-none"></div>
	</div>
}