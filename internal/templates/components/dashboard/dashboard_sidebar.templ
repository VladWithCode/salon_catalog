package dashboard

import "github.com/vladwithcode/salon_catalog/internal/templates/components"
import "github.com/vladwithcode/salon_catalog/internal/auth"
import "strings"

templ DashboardSidebar() {
	{{ user, _ := auth.ExtractAuthFromCtx(ctx) }}
	@sidebarScript()
	<div
		id="sidebar-dropshadow"
		class="fixed inset-0 z-50 bg-dark/30 opacity-0 pointer-events-none xl:hidden"
		data-click-handler-selector="sidebar-toggle"
		data-sidebar-toggle
		data-sidebar-force="close"
	></div>
	<aside
		id="sidebar"
		class="fixed inset-y-0 left-0 w-72 -translate-x-full z-50 p-0.5 xl:block xl:static xl:translate-x-0 xl:z-10 transition-[height] duration-100"
		data-sidebar-open="false"
	>
		<div class="w-full h-full bg-secondary text-primary/90 rounded-xs">
			<div class="relative flex flex-col h-full">
				<!-- Sidebar Header -->
				<div class="flex items-center justify-between h-16 px-6 bg-sidebar border-b border-sidebar-accent">
					<h1 class="text-xl font-semibold text-sidebar-foreground">Panel</h1>
					<button
						id="closeSidebar"
						class="lg:hidden text-sidebar-foreground hover:text-white"
						data-click-handler-selector="sidebar-toggle"
						data-sidebar-toggle
						data-sidebar-force="close"
					>
						<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
						</svg>
					</button>
				</div>
				<!-- Navigation Menu -->
				<nav class="flex-1 px-4 py-6 space-y-2 overflow-y-auto">
					<!-- Dashboard Home -->
					<a
						href="/panel"
						class="nav-item active flex items-center px-4 py-3 text-sm font-medium rounded-lg transition-colors"
					>
						<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2H5a2 2 0 00-2-2z"
							></path>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								stroke-width="2"
								d="M8 5a2 2 0 012-2h4a2 2 0 012 2v6H8V5z"
							></path>
						</svg>
						Panel
					</a>
					<!-- Products Section -->
					@SidebarSection("Productos", components.BoxIcon("h-5 mr-3", nil)) {
						@SidebarSectionNavItem("Productos", "/panel/productos", nil)
						// @SidebarSectionNavItem("Crear Producto", "/panel/productos/nuevo", nil)
						<div class="border-b border-accent/70">
							<p class="sr-only">sidebar separator</p>
						</div>
						@SidebarSectionNavItem("Categorías", "/panel/categorias", nil)
						// @SidebarSectionNavItem("Crear categoría", "/panel/categorias/nueva", templ.Attributes{})
					}
					<!-- Event Types Section -->
					<a
						href="/panel/tipos-eventos"
						class="nav-item flex items-center px-4 py-3 text-sm font-medium rounded-lg transition-colors"
					>
						<svg class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v16a2 2 0 002 2z"></path>
						</svg>
						Tipos de Eventos
					</a>
					<!-- Images Section -->
					@SidebarSection(
						"Imagenes",
						components.ImageIcon("h-5 mr-3", nil),
					) {
						@SidebarSectionNavItem("Imagenes", "/panel/imagenes", templ.Attributes{})
						@SidebarSectionNavItem("Nueva Imagen", "/panel/imagenes/nueva", templ.Attributes{})
					}
					<!-- Wizard Section -->
					@SidebarSection("Asistente de Eventos", components.WizardIcon("h-5 mr-3", nil)) {
						@SidebarSectionNavItem("Ver Asistentes", "/panel/asistente", templ.Attributes{})
						<div class="border-b border-accent/70">
							<p class="sr-only">sidebar separator</p>
						</div>
						@SidebarSectionNavItem("Pasos", "/panel/asistente/pasos", templ.Attributes{})
					}
					<!-- Contact Requests -->
					<a
						href="/panel/contacts"
						class="nav-item flex items-center px-4 py-3 text-sm font-medium rounded-lg transition-colors"
					>
						@components.ChatIcon("w-5 mr-3", nil)
						Solicitudes de Contacto
						if false {
							<span class="ml-auto bg-red-500 text-white text-xs px-2 py-1 rounded-full">{ 0 }</span>
						}
					</a>
					<!-- Quotes Section -->
					/* @SidebarSection(
                "Quotes",
                components.EmailIcon("h-5 mr-3"),
                ) {
                @SidebarSectionNavItem("Ver Quotes", "/panel/quotes", templ.Attributes{})
                @SidebarSectionNavItem("Crear Quote", "/panel/quotes/nuevo", templ.Attributes{})
                @SidebarSectionNavItem("Pending", "/panel/quotes/pending", templ.Attributes{})
                @SidebarSectionNavItem("Approved", "/panel/quotes/approved", templ.Attributes{})
                } */
					<!-- Analytics -->
					/* @SidebarSection("Analytics", components.GraphIcon("h-5 mr-3", templ.Attributes{})) {
                @SidebarSectionNavItem("Ver Reportes", "/panel/analytics", templ.Attributes{})
                @SidebarSectionNavItem("Crear Reportes", "/panel/analytics/nuevo", templ.Attributes{})
                } */
					<!-- Settings -->
					/* @SidebarSection("Settings", components.SettingsIcon("h-5 mr-3", templ.Attributes{})) {
                @SidebarSectionNavItem("General", "/panel/settings/general", templ.Attributes{})
                @SidebarSectionNavItem("Users", "/panel/settings/users", templ.Attributes{})
                @SidebarSectionNavItem("Permissions", "/panel/settings/permissions", templ.Attributes{})
                @SidebarSectionNavItem("Integrations", "/panel/settings/integrations", templ.Attributes{})
                } */
				</nav>
				<!-- Sidebar Footer -->
				<div class="p-4 border-t border-sidebar-accent">
					<div class="flex items-center space-x-3">
						<button
							type="button"
							id="sidebar-user-avatar"
							class="w-8 h-8 bg-blue-500 rounded-full flex items-center justify-center"
						>
							<span class="text-white text-sm font-medium">{ getUserInitals(user) }</span>
						</button>
						<div class="flex-1 min-w-0">
							<p class="text-sm font-medium text-sidebar-foreground truncate">{ user.Fullname }</p>
							<p class="text-xs text-sidebar-foreground/70 truncate">{ user.Username }</p>
						</div>
						<a href="/cerrar-sesion" class="text-sidebar-foreground/70 hover:text-sidebar-foreground">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"
								></path>
							</svg>
						</a>
					</div>
					<div id="sidebar-user-navigation" class="flex flex-col border-primary h-0" data-sidebar-user-nav="closed">
						<ul class="pt-4 text-primary/60 text-sm font-medium space-y-2">
							<li>
								<a href="/panel/usuario" class="block cursor-pointer underline underline-offset-2 hover:text-accent">Mi perfil</a>
							</li>
						</ul>
					</div>
				</div>
			</div>
		</div>
	</aside>
}

templ sidebarScript() {
	<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sidebarTl = gsap.timeline({paused: true, defaults: {duration: 0.3, ease: 'power2.out'}});
        sidebarTl.to('#sidebar', {
            x: '0%',
        }).to('#sidebar-dropshadow', {
            opacity: 1,
            pointerEvents: 'auto',
        }, "-=0.15");
        // Listen for multiple sidebar toggles
        eventManager.registerClick('sidebar-toggle', (e) => {
            const target = e.target.hasAttribute('data-sidebar-toggle') ? e.target : e.target.closest('[data-sidebar-toggle]');
            if (!target) {
                console.error('Invalid sidebar toggle target');
                return;
            }

            const force = target.dataset.sidebarForce;
            const sidebar = document.getElementById('sidebar');
            const isOpen = sidebar.dataset.sidebarOpen === 'true';
            const duration = 0.15;

            if (force) {
                if (force === 'open') {
                    sidebarTl.play();
                } else if (force === 'close') {
                    sidebarTl.reverse();
                }
            } else if (isOpen) {
                sidebarTl.reverse();
            } else {
                sidebarTl.play();
            }
        }).registerClick('#sidebar-user-avatar', function (e) {
        })

        const navSectionToggles = document.querySelectorAll('[data-nav-section-toggle]');
        for (const toggle of navSectionToggles) {
            toggle.addEventListener('click', function () {
                const section = this.closest('[data-nav-section]');
                if (!section) {
                    return;
                }

                const isOpen = section.dataset.navSection === 'open';
                const submenu = section.querySelector('[data-nav-section-submenu]')
                const chevron = this.querySelector('[data-nav-section-chevron]');
                const duration = 0.1;

                if (isOpen) {
                    gsap.to(submenu, {
                        height: 0,
                        duration,
                        ease: 'power2.out',
                    });
                    gsap.to(chevron, {
                        rotate: '-90deg',
                        duration,
                        ease: 'power2.out',
                    });
                    section.dataset.navSection = 'closed';
                } else {
                    gsap.to(submenu, {
                        height: 'auto',
                        duration,
                        ease: 'power2.out',
                    });
                    gsap.to(chevron, {
                        rotate: 0,
                        duration,
                        ease: 'power2.out',
                    });
                    section.dataset.navSection = 'open';
                }
            });
        }

        const userNavBtn = document.getElementById('sidebar-user-avatar');
        userNavBtn.addEventListener('click', function () {
            const userNav = document.getElementById('sidebar-user-navigation');
            if (userNav.dataset.sidebarUserNav === 'open') {
                gsap.to('#sidebar-user-navigation', {
                    height: 0,
                    duration: 0.3,
                    ease: 'power2.out',
                });
                userNav.dataset.sidebarUserNav = 'closed';
            } else {
                gsap.to('#sidebar-user-navigation', {
                    height: 'auto',
                    duration: 0.3,
                    ease: 'power2.out',
                });
                userNav.dataset.sidebarUserNav = 'open';
            }
        });
    });
</script>
}

templ SidebarSection(title string, icon templ.Component) {
	<div class="space-y-1" data-nav-section="closed" data-nav-section-title={ title }>
		<button
			class="nav-section-toggle w-full flex items-center justify-between px-4 py-3 text-sm font-medium text-sidebar-foreground hover:bg-sidebar-accent rounded-lg transition-colors"
			data-nav-section-toggle
		>
			<div class="flex items-center" data-nav-section-title>
				@icon
				{ title }
			</div>
			@components.ChevronIcon(
				"-rotate-90 w-4",
				templ.Attributes{
					"data-nav-section-chevron": true,
				},
			)
		</button>
		<div class="nav-submenu ml-8 space-y-1 h-0 overflow-hidden" data-nav-section-submenu>
			{ children... }
		</div>
	</div>
}

templ SidebarSectionNavItem(title, href string, attr templ.Attributes) {
	<a href={ href } class="nav-item block px-4 py-2 text-sm rounded-lg transition-colors" { attr... }>
		{ title }
	</a>
}

func getUserInitals(user *auth.Auth) string {
	if user == nil {
		return "?"
	}
	nameParts := strings.SplitN(user.Fullname, " ", 2)
	return nameParts[0][0:1]
}
