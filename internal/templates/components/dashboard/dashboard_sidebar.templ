                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
                <div class="nav-submenu ml-8 space-y-1">
                    <a href="/panel/settings/general"
                        class="nav-item block px-4 py-2 text-sm rounded-lg transition-colors">General</a>
                    <a href="/panel/settings/users"
