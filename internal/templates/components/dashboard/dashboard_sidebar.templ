templ sidebarScript() {
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sidebarTl = gsap.timeline({paused: true, defaults: {duration: 0.3, ease: 'power2.out'}});
        sidebarTl.to('#sidebar', {
            x: '0%',
        }).to('#sidebar-dropshadow', {
            opacity: 1,
            pointerEvents: 'auto',
        }, "-=0.15");
        // Listen for multiple sidebar toggles
        eventManager.registerClick('sidebar-toggle', (e) => {
            const target = e.target.hasAttribute('data-sidebar-toggle') ? e.target : e.target.closest('[data-sidebar-toggle]');
            if (!target) {
                console.error('Invalid sidebar toggle target');
                return;
            }

            const force = target.dataset.sidebarForce;
            const sidebar = document.getElementById('sidebar');
            const isOpen = sidebar.dataset.sidebarOpen === 'true';
            const duration = 0.15;

            if (force) {
                if (force === 'open') {
                    sidebarTl.play();
                } else if (force === 'close') {
                    sidebarTl.reverse();
                }
            } else if (isOpen) {
                sidebarTl.reverse();
            } else {
                sidebarTl.play();
            }
        })

        const navSectionToggles = document.querySelectorAll('[data-nav-section-toggle]');
        for (const toggle of navSectionToggles) {
            toggle.addEventListener('click', function () {
                const section = this.closest('[data-nav-section]');
                if (!section) {
                    return;
                }

                const isOpen = section.dataset.navSection === 'open';
                const submenu = section.querySelector('[data-nav-section-submenu]')
                const chevron = this.querySelector('[data-nav-section-chevron]');
                const duration = 0.1;

                if (isOpen) {
                    gsap.to(submenu, {
                        height: 0,
                        duration,
                        ease: 'power2.out',
                    });
                    gsap.to(chevron, {
                        rotate: '-90deg',
                        duration,
                        ease: 'power2.out',
                    });
                    section.dataset.navSection = 'closed';
                } else {
                    gsap.to(submenu, {
                        height: 'auto',
                        duration,
                        ease: 'power2.out',
                    });
                    gsap.to(chevron, {
                        rotate: 0,
                        duration,
                        ease: 'power2.out',
                    });
                    section.dataset.navSection = 'open';
                }
            });
        }
    });
</script>
}
