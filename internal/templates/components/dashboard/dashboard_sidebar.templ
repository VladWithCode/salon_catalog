            <!-- Settings -->
            /* <div class="space-y-1">
                <button
                    class="nav-section-toggle w-full flex items-center justify-between px-4 py-3 text-sm font-medium text-sidebar-foreground hover:bg-sidebar-accent rounded-lg transition-colors">
                    <div class="flex items-center">
