package dashboard

import (
	"github.com/vladwithcode/salon_catalog/internal/forms"
	"github.com/vladwithcode/salon_catalog/internal/templates/components"
)

templ EventKindCreateModal(errorMessage string) {
	<div id="event-kinds-modal-content" class="h-full flex flex-col gap-2 bg-stone-50 rounded-sm shadow p-2">
		<div class="flex-1 flex justify-between items-center">
			<h3 class="text-xl font-medium text-gray-700 tracking-tight flex-1 truncate">
				if errorMessage != "" {
					Ocurrió un error al crear el tipo de evento
				} else {
					Nuevo Tipo de Evento
				}
			</h3>
			<button
				id="event-kinds-modal-close"
				class="p-2 rounded-sm text-gray-700 bg-stone-50"
				data-event-kinds-modal-toggle="close"
				data-click-handler-selector="[data-event-kinds-modal-toggle]"
			>
				@components.TimesIcon("w-8 mx-auto", nil)
			</button>
		</div>
		if errorMessage != "" {
			<div class="flex-1 basis-full w-full overflow-hidden">
				<div class="flex flex-col items-center justify-center h-full">
					<p class="text-red-700/70 mx-auto">
						@components.TimesIcon("w-10 mx-auto", nil)
					</p>
					<p class="text-red-700 font-medium text-center mx-auto">{ errorMessage }</p>
				</div>
			</div>
		} else {
			@EventKindCreateForm()
		}
		<div class="flex-1 flex gap-2 justify-end items-center">
			<button
				id="event-kinds-modal-back"
				class="flex gap-1 px-4 py-2 bg-gray-700/20 text-gray-700 font-medium rounded-sm"
				data-event-kinds-modal-toggle="close"
				data-click-handler-selector="[data-event-kinds-modal-toggle]"
			>
				@components.ChevronIcon("w-5 rotate-90 stroke-4", nil)
				Cancelar
			</button>
		</div>
	</div>
}

templ EventKindEditModal(formState *forms.EventKindFormState, errorMessage string) {
	<div id="event-kinds-modal-content" class="h-full flex flex-col gap-2 bg-stone-50 rounded-sm shadow p-2">
		<div class="flex-1 flex justify-between items-center">
			<h3 class="text-xl font-medium text-gray-700 tracking-tight flex-1 truncate">
				if errorMessage != "" {
					Ocurrió un error al actualizar el tipo de evento
				} else {
					Editar Tipo de Evento
				}
			</h3>
			<button
				id="event-kinds-modal-close"
				class="p-2 rounded-sm text-gray-700 bg-stone-50"
				data-event-kinds-modal-toggle="close"
				data-click-handler-selector="[data-event-kinds-modal-toggle]"
			>
				@components.TimesIcon("w-8 mx-auto", nil)
			</button>
		</div>
		if errorMessage != "" {
			<div class="flex-1 basis-full w-full overflow-hidden">
				<div class="flex flex-col items-center justify-center h-full">
					<p class="text-red-700/70 mx-auto">
						@components.TimesIcon("w-10 mx-auto", nil)
					</p>
					<p class="text-red-700 font-medium text-center mx-auto">{ errorMessage }</p>
				</div>
			</div>
		} else {
			@EventKindEditForm(formState)
		}
		<div class="flex-1 flex gap-2 justify-end items-center">
			<button
				id="event-kinds-modal-back"
				class="flex gap-1 px-4 py-2 bg-gray-700/20 text-gray-700 font-medium rounded-sm"
				data-event-kinds-modal-toggle="close"
				data-click-handler-selector="[data-event-kinds-modal-toggle]"
			>
				@components.ChevronIcon("w-5 rotate-90 stroke-4", nil)
				Cancelar
			</button>
		</div>
	</div>
}

templ EventKindCreateForm() {
	<div class="flex-1 basis-full w-full overflow-hidden">
		<div class="h-full overflow-y-auto">
			<form
				hx-post="/panel/tipos-eventos/nuevo"
				hx-target="#event-kinds-table"
				hx-indicator="#event-kinds-table-loading"
				hx-disabled-elt="button[type=submit]"
				class="space-y-4 p-4"
			>
				<div class="space-y-4">
					<div>
						<label for="name" class="block text-sm font-medium text-gray-700 mb-1">
							Nombre *
						</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
							placeholder="Ej: Boda, Quinceañera, Evento Corporativo"
						/>
					</div>

					<div>
						<label for="description" class="block text-sm font-medium text-gray-700 mb-1">
							Descripción
						</label>
						<textarea
							id="description"
							name="description"
							rows="3"
							class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
							placeholder="Descripción opcional del tipo de evento"
						></textarea>
					</div>
				</div>

				<div class="flex justify-end pt-4">
					<button
						type="submit"
						class="flex items-center gap-2 px-4 py-2 bg-gray-700 text-stone-50 font-medium rounded-sm hover:bg-gray-800 focus:outline-accent disabled:opacity-50 disabled:cursor-not-allowed"
					>
						@components.PlusIcon("w-4", nil)
						Crear Tipo de Evento
					</button>
				</div>
			</form>
		</div>
	</div>
}

templ EventKindEditForm(formState *forms.EventKindFormState) {
	<div class="flex-1 basis-full w-full overflow-hidden">
		<div class="h-full overflow-y-auto">
			<form
				hx-put={ "/panel/tipos-eventos/" + formState.EventKind.ID }
				hx-target="#event-kinds-table"
				hx-indicator="#event-kinds-table-loading"
				hx-disabled-elt="button[type=submit]"
				class="space-y-4 p-4"
			>
				<div class="space-y-4">
					<div>
						<label for="name" class="block text-sm font-medium text-gray-700 mb-1">
							Nombre *
						</label>
						<input
							type="text"
							id="name"
							name="name"
							required
							value={ formState.Values.Name }
							class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
							placeholder="Ej: Boda, Quinceañera, Evento Corporativo"
						/>
					</div>

					<div>
						<label for="description" class="block text-sm font-medium text-gray-700 mb-1">
							Descripción
						</label>
						<textarea
							id="description"
							name="description"
							rows="3"
							class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
							placeholder="Descripción opcional del tipo de evento"
						>{ formState.Values.Description }</textarea>
					</div>
				</div>

				<div class="flex justify-end pt-4">
					<button
						type="submit"
						class="flex items-center gap-2 px-4 py-2 bg-gray-700 text-stone-50 font-medium rounded-sm hover:bg-gray-800 focus:outline-accent disabled:opacity-50 disabled:cursor-not-allowed"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
						</svg>
						Actualizar Tipo de Evento
					</button>
				</div>
			</form>
		</div>
	</div>
}