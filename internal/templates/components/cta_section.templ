package components

templ CTASection() {
	<section id="seccion-cta" class="text-center text-secondary bg-brand-1 px-4 py-16 space-y-4">
		<h2 class="text-2xl font-bold">¡Agenda ya!</h2>
		<p class="text-current">Ven a tener la mejor experiencia de eventos en Chenacolo</p>
		<a href="/solicitar-cotizacion" class="block bg-accent py-4 text-lg font-bold rounded-xs mt-8">Solicita tu cotización</a>
	</section>
}
