package components

import (
	"fmt"
	"github.com/vladwithcode/salon_catalog/internal/db"
	"sort"
)

type CatalogListings map[string][]db.CatalogProd

templ CatalogSection(listings map[string][]db.CatalogProd) {
	<section id="seccion-catalogo" class="relative z-0 overflow-hidden">
		<div class="absolute inset-0 z-0">
			<img
				src="/static/assets/chenacolo_24.jpeg"
				alt="Imagen del area de bar del salon de eventos"
				class="w-full h-full object-cover object-center"
			/>
		</div>
		<div class="bg-gradient-to-tl from-primary/80 to-accent/80 text-light relative w-full z-10 px-4 sm:px-6 lg:px-8 py-12 sm:py-16 lg:py-20">
			<div class="max-w-7xl mx-auto">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl text-center font-bold mb-4 sm:mb-6 translate-y-6 opacity-0 uppercase" data-intsc-animate-item="catalog-section">
					Conoce nuestro catálogo
				</h2>
				<p class="text-center text-current/80 text-base sm:text-lg mb-8 sm:mb-12 translate-y-6 opacity-0" data-intsc-animate-item="catalog-section">
					Tenemos una gran repertorio de mesas, copas y otros utensilios para brindarte la experiencia perfecta.
				</p>
				<div class="space-y-6 sm:space-y-8">
					if len(listings) > 0 {
						for _, category := range sortedListings(listings) {
							@CatalogListing(category, listings[category])
						}
					} else {
						<a
							href="/catalogo"
							class="block relative w-full max-w-sm sm:max-w-md lg:max-w-lg aspect-square mx-auto overflow-hidden transition-[scale] group hover:scale-110 active:scale-110 translate-y-6 opacity-0 rounded-lg"
							data-intsc-animate-item="catalog-section"
						>
							<img
								src="/static/assets/chenacolo_24.jpeg"
								alt="Imagen del area de bar del salon de eventos"
								class="absolute inset-0 w-full object-cover object-center z-0"
							/>
							<div
								class="relative flex flex-col items-center justify-center bg-stone-200/90 text-dark w-full h-full p-4 sm:p-6 lg:p-8 z-10"
							>
								<h3 class="text-2xl sm:text-3xl lg:text-4xl font-bold uppercase mb-2">Ver Catálogo</h3>
							</div>
						</a>
					}
				</div>
			</div>
		</div>
	</section>
}

templ CatalogListing(listingTitle string, listing []db.CatalogProd) {
	<div class="space-y-3 sm:space-y-4">
		<h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-light/90">{ listingTitle }</h3>
		<div class="flex gap-3 sm:gap-4 lg:gap-5 text-center overflow-x-auto overflow-y-hidden pb-2">
			for _, item := range listing {
				@CatalogListingItem(item)
			}
			<a
				href={ fmt.Sprintf("/catalogo?search=%s", listingTitle) }
				class="block relative grow-0 shrink-0 basis-48 sm:basis-56 lg:basis-64 aspect-square overflow-hidden transition-[scale] group hover:scale-110 active:scale-110 translate-y-6 opacity-0 rounded-lg"
				data-intsc-animate-item="catalog-section"
			>
				<div
					class="absolute inset-0 flex flex-col items-center justify-center h-full gap-1 sm:gap-2 bg-stone-200/90 text-dark text-start p-3 sm:p-4 z-10"
				>
					<h3 class="text-sm sm:text-lg lg:text-xl font-bold uppercase text-ellipsis line-clamp-2">Ver todos</h3>
				</div>
			</a>
		</div>
	</div>
}

templ CatalogListingItem(item db.CatalogProd) {
	<a
		href={ fmt.Sprintf("/productos/%s", item.Slug) }
		class="block relative grow-0 shrink-0 basis-48 sm:basis-56 lg:basis-64 aspect-square overflow-hidden transition-[scale] group hover:scale-110 active:scale-110 translate-y-6 opacity-0 rounded-lg"
		data-intsc-animate-item="catalog-section"
	>
		<img
			src={ getMainImg(item) }
			alt={ fmt.Sprintf("Imagen principal del producto %s.", item.Name) }
			class="absolute inset-0 w-full object-cover object-center z-0 pointer-events-none select-none"
		/>
		<div
			class="absolute bottom-0 inset-x-0 h-2/5 flex flex-col gap-1 sm:gap-2 bg-stone-200/90 text-dark text-start p-3 sm:p-4 z-10"
		>
			<h3 class="text-sm sm:text-lg lg:text-xl font-bold uppercase text-ellipsis line-clamp-2 flex-1">{ item.Name }</h3>
			<p class="text-[4px] group-hover:text-xs sm:group-hover:text-sm group-active:text-xs sm:group-active:text-sm group-hover:opacity-100 group-active:opacity-100 transition-[font-size,opacity] opacity-0 underline duration-120">
				Ver detalles
			</p>
		</div>
	</a>
}

func getMainImg(item db.CatalogProd) string {
	if item.ImageURL != "" {
		return fmt.Sprintf("/static/uploads/%s", item.ImageURL)
	}
	return "/static/assets/chenacolo_24.jpeg"
}

func sortedListings(listings map[string][]db.CatalogProd) []string {
	titles := make([]string, len(listings))

	i := 0
	for k, _ := range listings {
		titles[i] = k
		i++
	}

	sort.Strings(titles)

	return titles
}
