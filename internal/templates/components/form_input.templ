package components
// components/input.templ
package components

type InputProps struct {
    Name        string
    Type        string
    Label       string
    Placeholder string
    Value       string
    Error       string
    Required    bool
    Disabled    bool
    ID          string
    Class       string
    HXTrigger   string

    HXPost      string
    HXTarget    string
    HXSwap      string
    Icon        string
    HelpText    string
}

templ Input(props InputProps) {
    <div class="form-group space-y-1">
        <!-- Label -->
        if props.Label != "" {
            <label 
                for={ getID(props) }
                class={ "block text-sm font-medium transition-colors duration-200",
                    templ.KV("text-red-700", props.Error != ""),
                    templ.KV("text-gray-700", props.Error == "") }
            >
                { props.Label }

                if props.Required {
                    <span class="text-red-500 ml-1">*</span>
                }
            </label>
        }
        <!-- Input Container -->
        <div class="relative">
            <!-- Icon (if provided) -->
            if props.Icon != "" {
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    @renderIcon(props.Icon, props.Error != "")
                </div>
            }
            <!-- Input Field -->
            <input
                type={ props.Type }
                name={ props.Name }
                id={ getID(props) }
                value={ props.Value }
                placeholder={ props.Placeholder }
                required?={ props.Required }
                disabled?={ props.Disabled }
                if props.HXTrigger != "" {
                    hx-trigger={ props.HXTrigger }
                }
                if props.HXPost != "" {
                    hx-post={ props.HXPost }
                }
                if props.HXTarget != "" {
                    hx-target={ props.HXTarget }
                }
                if props.HXSwap != "" {
                    hx-swap={ props.HXSwap }
                }
                class={
                    getInputClasses(props),
                    props.Class
                }
            />

            <!-- Loading Spinner (for HTMX requests) -->
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none htmx-indicator">
                <svg class="animate-spin h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
            </div>
        </div>

        <!-- Error Message -->
        if props.Error != "" {
            <div class="error-message">
                <p class="mt-1 text-sm text-red-600 flex items-center">
                    <svg class="h-4 w-4 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                    </svg>
                    { props.Error }
                </p>
            </div>
        }

        <!-- Help Text -->
        if props.HelpText != "" && props.Error == "" {
            <p class="mt-1 text-sm text-gray-500">{ props.HelpText }</p>
        }
    </div>
}

// Helper functions
func getID(props InputProps) string {
    if props.ID != "" {
        return props.ID
    }
    return props.Name
}

func getInputClasses(props InputProps) string {
    baseClasses := "block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 transition-all duration-200 placeholder-gray-400"
    iconPadding := ""
    if props.Icon != "" {
        iconPadding = " pl-10"
    }
    if props.Error != "" {
        return baseClasses + iconPadding + " border-red-300 bg-red-50 text-red-900 placeholder-red-300 focus:ring-red-500 focus:border-red-500"
    }
    if props.Disabled {
        return baseClasses + iconPadding + " border-gray-200 bg-gray-50 text-gray-500 cursor-not-allowed"
    }
    return baseClasses + iconPadding + " border-gray-300 bg-white text-gray-900 focus:ring-blue-500 focus:border-blue-500 hover:border-gray-400"
}
