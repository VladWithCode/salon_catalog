templ SocialsIndex(links []db.SocialLink, sections []db.SocialSection, sectionLinks []db.SocialSectionLink) {
	<script src="/static/js/imageSelectorManager.js" defer></script>
	@socialScript()
	@templates.AdminLayout("Redes Sociales | Panel Villa Chenacolo", "Administración de Redes Sociales") {
		<div class="flex-1 flex flex-col overflow-hidden space-y-4 px-0.5">
			<div class="px-2">
				<div class="flex gap-4 justify-between pb-2">
					<div class="space-y-0.5">
						<h1 class="text-3xl tracking-tight">Redes Sociales</h1>
						<p class="text-xs text-current/50">Administra los enlaces de redes sociales para el sitio web.</p>
					</div>
				</div>
				<div class="py-2">
