package dashboard

import (
	"github.com/vladwithcode/salon_catalog/internal/templates"
	"github.com/vladwithcode/salon_catalog/internal/templates/components"
)

templ Categories() {
	<script src="/static/js/popup.js" defer></script>
	@categoriesScript()
	@templates.AdminLayout("Categorías | Panel Villa Chenacolo", "Administración de Categorías") {
		<div class="flex-1 flex flex-col overflow-hidden space-y-4 px-0.5" hx-ext="response-targets">
			<div class="px-2">
				<div class="flex gap-4 justify-between pb-2">
					<div class="space-y-0.5">
						<h1 class="text-3xl tracking-tight">Categorías</h1>
						<p class="text-xs text-current/50">Agrega, modifica y elimina categorías de tu catálogo.</p>
					</div>
					<button
						id="categories-actions-toggle"
						class="shrink flex items-center justify-center text-current/80 xl:hidden"
						data-click-handler-selector="categories-actions-toggle"
					>
						@components.BarsIcon("w-8", nil)
					</button>
				</div>
				<div id="categories-actions-container" class="overflow-hidden h-0 opacity-0 xl:h-auto xl:opacity-100" data-categories-actions="closed">
					<div class="py-2">
						<div class="lg:flex items-center gap-4">
							<ul class="lg:basis-1/3 flex flex-col items-center gap-2">
								<li class="w-full">
									<button
										id="categories-actions-new"
										hx-get="/categorias/nueva"
										hx-target="#categories-modal"
										hx-indicator="#global-loading-indicator"
										class="w-full flex items-center justify-center gap-4 px-4 py-3 text-sm bg-gray-700 text-stone-50 font-medium rounded-lg focus:outline-accent"
									>
										@components.PlusIcon("w-5", nil)
										Nueva Categoría
									</button>
								</li>
								<li class="w-full">
									<button
										id="categories-multi-selection-delete"
										data-categories-multi-action="delete"
										hx-delete="/categorias"
										hx-target="#categories-table"
										hx-confirm="¿Eliminar las categorías seleccionadas? ADVERTENCIA: Esto también eliminará todos los productos de estas categorías."
										hx-indicator="#categories-table-loading"
										hx-include='[name="category-table-selection"]'
										class="w-full flex items-center justify-center gap-4 px-4 py-3 text-sm bg-red-500 text-stone-50 font-medium rounded-lg transition-[background,_filter] duration-300 focus:outline-accent disabled:bg-red-500/80 disabled:cursor-not-allowed disabled:brightness-80"
										disabled
									>
										@components.BinIcon("w-5", nil)
										Eliminar Selección
									</button>
								</li>
							</ul>
							<!-- Filters -->
							<form
								hx-get="/categorias"
								hx-trigger="input changed delay:500ms"
								hx-target="#categories-table"
								hx-indicator="#categories-table-loading"
								hx-include='[name="sort"]'
								class="shrink grow-0 basis-auto lg:flex-1 pt-2 space-y-1"
							>
								<h3 class="font-light text-gray-700/70">Filtrar Categorías</h3>
								<div class="flex items-center gap-0.5">
									<div class="h-full flex-1 basis-full space-y-1">
										<label for="search" class="block text-sm font-medium text-gray-700">Buscar Categorías</label>
										<input
											id="search"
											name="search"
											class="block w-full px-4 py-2 border border-gray-200 rounded-xs leading-5 bg-white placeholder-gray-500 focus:outline-none focus:placeholder-gray-400 focus:ring-1 focus:ring-accent focus:border-accent"
											type="text"
											placeholder="Buscar por nombre o descripción..."
										/>
									</div>
								</div>
								<div class="flex items-center justify-end pt-1">
									<button
										type="button"
										class="text-sm text-gray-700 font-bold tracking-wide"
										hx-get="/categorias"
										hx-target="#categories-table"
										data-click-handler-selector="[data-categories-filter-clear]"
										data-categories-filter-clear
									>
										Limpiar Filtros
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
			<main class="relative z-0 flex-1 overflow-hidden">
				<div class="h-full flex flex-col rounded-xs bg-white shadow-sm overflow-auto scroll-smooth pb-11" data-categories-table-scroll>
					<div
						class="sticky inset-x-0 top-0 z-20 bg-white flex items-center justify-between gap-3 p-2 border border-gray-100 rounded-sm shadow-sm"
					>
						// Button modes: all, none, some
						<style>
                            [data-multi-selection-mode="all"] [data-multi-selection-mode-display="all"] {
                                opacity: 1;
                            }
                            [data-multi-selection-mode="none"] [data-multi-selection-mode-display="none"] {
                                opacity: 1;
                            }
                            [data-multi-selection-mode="some"] [data-multi-selection-mode-display="some"] {
                                opacity: 1;
                            }
                            [data-multi-selection-mode-display] {
                                transition: opacity 0.1s linear;
                            }
                        </style>
						<button
							id="categories-table-multi-selection-ctl"
							type="button"
							class="shrink-0 grow-0 basis-5 aspect-square grid grid-cols-1 grid-rows-1"
							data-click-handler-selector="#categories-table-multi-selection-ctl"
							data-multi-selection-mode="all"
						>
							<div
								class="col-start-1 row-start-1 w-full h-full border border-gray-300 rounded-xs"
								data-multi-selection-mode-display="all"
							></div>
							<div
								class="col-start-1 row-start-1 w-full h-full flex items-center justify-center border border-blue-400 bg-blue-500 rounded-xs opacity-0"
								data-multi-selection-mode-display="none"
							>
								@components.CheckIcon("w-full text-gray-50", nil)
							</div>
							<div
								class="col-start-1 row-start-1 w-full h-full flex items-center justify-center border border-blue-400 bg-blue-500 rounded-xs opacity-0"
								data-multi-selection-mode-display="some"
							>
								<div class="w-3/4 h-0.5 bg-stone-50 rounded-xs"></div>
							</div>
						</button>
						<h4 class="flex-1 basis-full text-gray-900">
							Categorías
							<span id="categories-table-count" hx-swap-oob>(0/0)</span>
						</h4>
						<select
							hx-get="/categorias"
							hx-trigger="change"
							hx-target="#categories-table"
							hx-indicator="#categories-table-loading"
							hx-include='[name="search"]'
							name="sort"
							id="sort"
							class="block px-1 py-0.5 border border-gray-200 rounded-xs"
						>
							<option value="name_asc">A-Z &uarr;</option>
							<option value="name_desc">A-Z &darr;</option>
							<option value="newest">Más Recientes</option>
							<option value="oldest">Más Antiguas</option>
						</select>
					</div>
					<div class="flex-1 grid grid-cols-1 grid-rows-1">
						<div class="static h-full col-start-1 row-start-1 pointer-events-none z-10">
							<div
								id="categories-table-loading"
								class="h-full max-h-[60vh] bg-white p-8 text-center inset-0 flex flex-col items-center justify-center loading-table-indicator"
							>
								@components.LoadingIcon("h-12 text-primary mx-auto", nil)
								<p class="mt-2 text-gray-500">Cargando categorías...</p>
							</div>
						</div>
						<div
							class="static col-start-1 row-start-1 z-0 h-0 opacity-0 -mt-px"
							data-categories-table-container="expanded"
						>
							<div
								id="categories-table"
								hx-get="/categorias"
								hx-include='[name="search"], [name="sort"]'
								hx-target-5xx="this"
								hx-target-4xx="this"
								hx-trigger="load"
								hx-indicator="#categories-table-loading"
							></div>
						</div>
					</div>
					<div
						class="absolute inset-x-1.5 bottom-1.5 z-20 bg-white border border-gray-100 rounded-sm shadow-sm"
						id="categories-table-pagination"
					></div>
				</div>
			</main>
		</div>
		<div id="categories-modal-container" class="fixed inset-0 w-screen z-40 flex flex-col justify-center items-center overflow-hidden opacity-0 pointer-events-none">
			<div
				id="categories-modal-backdrop"
				class="absolute h-full w-full z-0 bg-dark/30"
				data-categories-modal-toggle="close"
				data-click-handler-selector="[data-categories-modal-toggle]"
			></div>
			<div
				id="categories-modal"
				class="basis-9/10 relative w-full max-w-sm sm:max-w-md md:max-w-lg lg:max-w-2xl p-2 overflow-hidden z-20 translate-y-12 opacity-0"
				data-categories-modal="closed"
			></div>
		</div>
		<template id="max-prio-popup">
			<div
				data-max-prio-popup
				class="fixed inset-0 w-screen h-screen z-50 flex flex-col justify-center items-center overflow-hidden bg-dark/60"
				data-click-handler-selector="max-prio-popup-close"
			>
				<button
					class="absolute top-4 right-4 z-10 text-gray-50 hover:text-gray-200 transition-colors"
					data-click-handler-selector="max-prio-popup-close"
				>
					@components.TimesIcon("w-8 h-8", nil)
				</button>
				<div id="max-prio-popup-content" class="w-full bg-light flex flex-col rounded-lg p-1"></div>
			</div>
		</template>
		<template id="category-modal-image">
			<img class="w-full my-auto object-contain rounded-lg" src="placeholder.jpg" alt="" data-category-modal-image=""/>
		</template>
	}
}

templ categoriesScript() {
	<script>
        document.addEventListener('DOMContentLoaded', function () {
            // Register gsap plugins
            gsap.registerPlugin(window.ScrollTrigger);

            const toggleActionsTl = gsap.timeline({paused: true, defaults: {duration: 0.3, ease: 'power2.out'}});
            toggleActionsTl.to('#categories-actions-container', {opacity: 1, height: 'auto'});

            const modalTl = gsap.timeline({paused: true, defaults: {duration: 0.5, ease: 'power3.out'}});
            modalTl.set('#categories-modal-container', {
                pointerEvents: 'auto',
            }).to('#categories-modal-container', {
                opacity: 1,
                duration: 0.2,
            }).to('#categories-modal', {
                opacity: 1,
                y: '0rem',
            }, "-=0.1");

            eventManager
                .register('beforeRequest', '#categories-table', function (e) {
                    gsap.set('[data-categories-table-container]', { pointerEvents: 'none' });
                    gsap.to(
                        '[data-categories-table-container]', 
                        { height: '0rem', opacity: 0, },
                    )
                    gsap.to(
                        '[data-categories-table-row]', 
                        { y: '0rem', opacity: 1, stagger: 0.05, },
                        { y: '10rem', opacity: 0, stagger: 0.05, },
                    );
                })
                .register('configRequest', '[data-categories-multi-action]', function (e) {
                    const ids = e.detail.parameters.getAll('category-table-selection');
                    for (const id of ids) {
                        e.detail.parameters.append('ids', id);
                    }

                    e.detail.parameters.delete('category-table-selection');
                })
                .register('afterSwap', '#categories-table', function (e) {
                    gsap.to(
                        '[data-categories-table-container]', 
                        { height: 'auto', opacity: 1, duration: 0.5, ease: 'power2.out' },
                    )
                    gsap.fromTo(
                        '[data-categories-table-row]', 
                        { y: '1rem', opacity: 0, duration: 0.3, stagger: 0.05, ease: 'power2.out' },
                        { y: '0rem', opacity: 1 },
                        "<",
                    );
                    gsap.set('[data-categories-table-container]', { pointerEvents: 'auto' });

                    // Scroll to top of table
                    const tableScroll = e.detail.target.closest('[data-categories-table-scroll]');
                    if (tableScroll) {
                        tableScroll.scrollTo(0, 0);
                    }

                    // Close modal if open
                    const modal = document.getElementById('categories-modal');
                    if (modal.dataset.categoriesModal === 'open') {
                        modalTl.reverse();
                        modal.dataset.categoriesModal = 'closed';
                    }

                    updateCategoriesTableSelection();
                })
                .register('afterSwap', '#categories-modal', function (e) {
                    if (e.detail.elt.dataset.categoriesModal === 'closed') {
                        modalTl.play();
                        e.detail.elt.dataset.categoriesModal = 'open';
                    }

                    // Reset create form if it exists
                    const createForm = document.querySelector('#categories-modal form[hx-post]');
                    if (createForm) {
                        createForm.reset();
                    }
                })
                .registerClick('categories-actions-toggle', function (e) {
                    const actionsContainer = document.getElementById('categories-actions-container')
                    if (actionsContainer.dataset.categoriesActions === 'open') {
                        toggleActionsTl.reverse();
                        actionsContainer.dataset.categoriesActions = 'closed';
                    } else {
                        toggleActionsTl.play();
                        actionsContainer.dataset.categoriesActions = 'open';
                    }
                })
                .registerClick('[data-categories-modal-toggle]', function (e) {
                    const target = e.target.matches('[data-categories-modal-toggle]')
                        ? e.target
                        : e.target.closest('[data-categories-modal-toggle]');
                    const modal = document.getElementById('categories-modal');

                    const force = target.dataset.categoriesModalToggle
                    const shouldClose = (force === 'close') || (!force && modal.dataset.categoriesModal === 'open');
                    if (shouldClose) {
                        modalTl.reverse();
                        modal.dataset.categoriesModal = 'closed';
                    } else {
                        modalTl.play();
                        modal.dataset.categoriesModal = 'open';
                    }
                })
                .registerClick('[data-categories-filter-clear]', function (e) {
                    clearCategoriesTableFilters();
                })
                .registerClick('[data-categories-modal-tab]', function (e) {
                    const activeBgValues = "54 65 83";
                    const target = e.target.matches('[data-categories-modal-tab]')
                        ? e.target
                        : e.target.closest('[data-categories-modal-tab]');
                    const tab = target.dataset.categoriesModalTab;
                    const form = document.getElementById('categories-modal-form');
                    const images = document.getElementById('categories-modal-images');
                    const tl = gsap.timeline({defaults: {duration: 0.3, ease: 'power2.out'}});

                    let inactiveTabs = [];
                    let activeTab = form;
                    switch (tab) {
                    case 'categories-modal-images':
                        inactiveTabs.push(form);
                        activeTab = images;
                        break;
                    case 'categories-modal-form':
                    default:
                        inactiveTabs.push(images);
                        activeTab = form;
                        break;
                    }

                    tl.to(target, {backgroundColor: `rgb(${activeBgValues})`, color: `rgb(240 240 240)`})
                        .to('[data-categories-modal-tab]:not([data-categories-modal-tab="'+tab+'"])', {backgroundColor: `rgb(${activeBgValues} / 0%)`, color: `rgb(${activeBgValues})`}, "<")
                        .to(activeTab, {opacity: 1, x: '0', pointerEvents: 'auto'}, "<")
                        .to(inactiveTabs, {opacity: 0, x: '100%', pointerEvents: 'none'}, '<');
                })
                .register('afterSwap', '#headerImgSection', function (e) {
                    const selectorModal = document.getElementById('image-selector-modal');
                    if (selectorModal) {
                        gsap.to(selectorModal, {
                            opacity: 0,
                            y: '10rem',
                            pointerEvents: 'none',
                            ease: 'power2.out',
                            duration: 0.5,
                            onComplete: () => {
                                selectorModal.remove();
                            },
                        });
                    }
                })
                .register('afterSwap', '#displayImgSection', function (e) {
                    const selectorModal = document.getElementById('image-selector-modal');
                    if (selectorModal) {
                        gsap.to(selectorModal, {
                            opacity: 0,
                            y: '10rem',
                            pointerEvents: 'none',
                            ease: 'power2.out',
                            duration: 0.5,
                            onComplete: () => {
                                selectorModal.remove();
                            },
                        });
                    }
                })
                .registerClick('close-images-selector-modal', function (e) {
                    gsap.to('#image-selector-modal',{
                        opacity: 0,
                        y: '2.5rem',
                        pointerEvents: 'none',
                        ease: 'power2.out',
                        duration: 0.5,
                        onComplete: () => {
                            document.getElementById('image-selector-modal')?.remove();
                        },
                    })
                })
                .registerClick('category-modal-images-btn', function (e) {
                    const target = e.target.matches('[data-click-handler-selector]')
                        ? e.target
                        : e.target.closest('[data-click-handler-selector]');
                    const imgPopup = document.getElementById('max-prio-popup').content.cloneNode(true);
                    const imgElem = document.getElementById('category-modal-image').content.cloneNode(true);
                    imgElem.children[0].src = target.querySelector('img').src;
                    const popupContent = imgPopup.querySelector('#max-prio-popup-content');

                    popupContent.appendChild(imgElem.children[0]);
                    document.body.appendChild(imgPopup);

                    gsap.set(popupContent, {
                        opacity: 0,
                        y: '12rem',
                        pointerEvents: 'none',
                    });
                    gsap.to(popupContent, {
                        opacity: 1,
                        y: 0,
                        duration: 0.5,
                        ease: 'power2.in',
                    });
                })
                .registerClick('max-prio-popup-close', function (e) {
                    gsap.to('[data-max-prio-popup]', {
                        opacity: 0,
                        y: '12rem',
                        pointerEvents: 'none',
                        ease: 'power2.out',
                        duration: 0.5,
                        onComplete: () => {
                            document.querySelector('[data-max-prio-popup]').remove();
                        },
                    });
                })
                .registerClick('#categories-table-multi-selection-ctl', function (e) {
                    const target = e.target.matches('[data-multi-selection-mode]')
                        ? e.target
                        : e.target.closest('[data-multi-selection-mode]');
                        
                    const mode = target.dataset.multiSelectionMode;
                    switch (mode) {
                        case 'none':
                            document.querySelectorAll('[name="category-table-selection"]').forEach(function (cat) {
                                cat.checked = false;
                            });
                            updateCategoriesTableSelection();
                            break;
                        case 'some':
                            document.querySelectorAll('[name="category-table-selection"]:checked').forEach(function (cat) {
                                cat.checked = false;
                            });
                            updateCategoriesTableSelection();
                            break;
                        case 'all':
                        default:
                            document.querySelectorAll('[name="category-table-selection"]').forEach(function (cat) {
                                cat.checked = true;
                            });
                            updateCategoriesTableSelection();
                            break;
                    }
                });

            document.addEventListener('input', function (e) {
                if (!e.target.matches('[name="category-table-selection"]')) {
                    return;
                }
                updateCategoriesTableSelection();
            });

            function updateCategoriesTableSelection() {
                const totalCats = document.querySelectorAll('[name="category-table-selection"]').length;
                const selectedCats = document.querySelectorAll('[name="category-table-selection"]:checked');
                if (selectedCats.length === 0) {
                    document.getElementById('categories-multi-selection-delete').disabled = true;
                    document.getElementById('categories-table-multi-selection-ctl').dataset.multiSelectionMode = 'all';
                    return;
                }

                if (selectedCats.length === totalCats) {
                    document.getElementById('categories-table-multi-selection-ctl').dataset.multiSelectionMode = 'none';
                } else {
                    document.getElementById('categories-table-multi-selection-ctl').dataset.multiSelectionMode = 'some';
                }

                document.getElementById('categories-multi-selection-delete').disabled = false;
            }

            function clearCategoriesTableFilters() {
                document.getElementById('search').value = '';
            }
        });
    </script>
}
