package pages

import "github.com/vladwithcode/salon_catalog/internal/templates"
import "github.com/vladwithcode/salon_catalog/internal/templates/components"
import "github.com/vladwithcode/salon_catalog/internal/db"
import "fmt"

type QuoteRequestFormState struct {
	NameValue      string
	NameError      string
	PhoneValue     string
	PhoneError     string
	EventDateValue string
	EventDateError string
	EventTypeValue string
	EventTypeError string
	ServerError    string
	IsSuccessful   bool

	ShouldOobSwapItems bool

	// New fields for database integration
	Cart       []*db.CartItem
	EventKinds []*db.EventKind
	CartError  string
}

templ QuoteRequest(formState *QuoteRequestFormState) {
	@templates.BaseLayout("Solicitar Cotización | Villa Chenacolo", nil, false) {
		@components.Toaster()
		<main class="relative min-h-screen lg:min-h-[80vh] flex flex-col items-center justify-center z-0 bg-brand-1-lg overflow-hidden pt-16 lg:pt-24 pb-8" hx-ext="response-targets">
			<div class="absolute inset-0 z-0 bg-paper" style="clip-path: polygon(0 55%, 100% 45%, 100% 100%, 0% 100%);"></div>
			<div class="relative z-10 flex items-center justify-center max-w-9/10 lg:h-fit">
				<div class="h-full w-full max-w-sm md:max-w-2xl">
					@templ.Fragment("quoteRequestForm") {
						<form
							id="quote-request-form"
							hx-post="/solicitar-cotizacion"
							hx-target-5xx="#quote-request-form"
							hx-target-4xx="#quote-request-form"
							hx-swap="outerHTML"
							hx-indicator=".form-loading"
							class="bg-stone-50 max-w-full rounded-xs shadow-sm shadow-stone-800/30 px-4 py-6 md:px-6 md:py-8 space-y-6 md:space-y-8"
							if formState.NameError != "" || formState.PhoneError != "" || formState.EventDateError != "" || formState.EventTypeError != "" || formState.CartError != "" {
								data-invalid="true"
							}
						>
							<!-- Header Section -->
							<div class="text-center space-y-2">
								<h1 class="text-2xl md:text-3xl font-bold tracking-wide text-primary">Solicitar Cotización</h1>
								<p class="text-sm md:text-base text-gray-600">Completa el formulario y nos pondremos en contacto contigo</p>
							</div>
							<!-- Form Fields: Mobile stacked, Desktop 2-column -->
							<div class="space-y-4 md:grid md:grid-cols-2 md:grid-rows-2 md:gap-4 md:space-y-0">
								<!-- Customer Info -->
								<div class="space-y-4 md:grid md:grid-rows-subgrid md:row-span-2 md:space-y-0">
									<div class="md:row-start-1">
										@components.Input(components.InputProps{
											Name:        "name",
											Type:        "text",
											Value:       formState.NameValue,
											Label:       "Nombre completo",
											Required:    true,
											Icon:        components.IconUser,
											Error:       formState.NameError,
											Placeholder: "Tu nombre completo",
										})
									</div>
									<div class="md:row-start-2">
										@components.Input(components.InputProps{
											Name:        "phone",
											Type:        "tel",
											Value:       formState.PhoneValue,
											Label:       "Teléfono",
											Required:    true,
											Icon:        components.IconPhone,
											Error:       formState.PhoneError,
											Placeholder: "Tu número de teléfono",
										})
									</div>
								</div>
								<!-- Event Info -->
								<div class="space-y-4 md:grid md:grid-rows-subgrid md:row-span-2 md:space-y-0">
									@components.Input(components.InputProps{
										Name:     "event_date",
										Type:     "date",
										Value:    formState.EventDateValue,
										Label:    "Fecha y hora del evento",
										Required: false,
										Error:    formState.EventDateError,
										HelpText: "Fecha aproximada de tu evento",
										Class:    "md:row-start-1",
									})
									<!-- Event Type Selection -->
									<div class="space-y-1 md:row-start-2">
										<label for="event_type" class={ "block text-sm font-medium transition-colors duration-200", templ.KV("text-red-700", formState.EventTypeError != ""), templ.KV("text-gray-700", formState.EventTypeError == "") }>
											Tipo de evento
											<span class="text-gray-500 text-xs ml-1">(opcional)</span>
										</label>
										<select
											name="event_type"
											id="event_type"
											class={
												"block w-full px-3 py-2 border rounded-md shadow-sm focus:outline-none focus:ring-2 transition-all duration-200",
												templ.KV("input-error", formState.EventTypeError != ""),
												templ.KV("input-base", formState.EventTypeError == ""),
											}
										>
											<option value="">Sin Asignar</option>
											for _, eventKind := range formState.EventKinds {
												<option
													value={ eventKind.ID }
													if formState.EventTypeValue == eventKind.ID {
														selected
													}
												>
													{ eventKind.Name }
												</option>
											}
											<option
												value="otro"
												if formState.EventTypeValue == "otro" {
													selected
												}
											>Otro</option>
										</select>
										if formState.EventTypeError != "" {
											<p class="mt-1 text-sm text-red-600 flex items-center">
												<svg class="h-4 w-4 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
													<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
												</svg>
												{ formState.EventTypeError }
											</p>
										}
									</div>
								</div>
							</div>
							<!-- Cart Section: Full width on all screens -->
							<div class="space-y-4">
								<div class="bg-gray-50 rounded-md p-4 border border-gray-200">
									<div class="flex items-center justify-between mb-4">
										<h3 class="text-lg font-semibold text-gray-800">Productos seleccionados</h3>
										if len(formState.Cart) > 0 {
											<span class="text-sm text-gray-600">{ fmt.Sprintf("%d productos", len(formState.Cart)) }</span>
										}
									</div>
									@templ.Fragment("cartItems") {
										<div
											id="cart-items"
											class="space-y-6"
											if formState.ShouldOobSwapItems {
												hx-swap-oob="outerHTML:#cart-items"
											}
										>
											<div class="space-y-3">
												if len(formState.Cart) == 0 {
													<div class="text-center py-8 space-y-3">
														<p class="text-gray-500">No hay productos en el carrito</p>
														<a
															href="/catalogo"
															class="inline-flex items-center px-4 py-2 bg-accent text-white text-sm font-medium rounded-md hover:bg-accent/90 transition-colors"
															onclick="return confirmNavigation()"
														>
															Explorar Catálogo
														</a>
													</div>
												} else {
													for _, item := range formState.Cart {
														@quoteCartItem(item)
													}
												}
											</div>
											if formState.CartError != "" {
												<div class="mt-3 p-3 bg-red-50 border border-red-200 rounded-md">
													<p class="text-sm text-red-700 flex items-center">
														<svg class="h-4 w-4 mr-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
															<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
														</svg>
														{ formState.CartError }
													</p>
												</div>
											}
										</div>
									}
								</div>
							</div>
							<!-- Server Error -->
							if formState.ServerError != "" {
								<div class="bg-red-50 border border-red-200 rounded-lg p-4">
									<div class="flex">
										<svg class="h-5 w-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
										</svg>
										<p class="text-sm text-red-700">{ formState.ServerError }</p>
									</div>
								</div>
							}
							if formState.IsSuccessful {
								<div class="bg-green-50 border border-green-200 rounded-lg p-4">
									<div class="flex items-center gap-4">
										<div class="rounded-full bg-green-700 p-px text-light">
											@components.CheckIcon("w-8", nil)
										</div>
										<p class="text-sm text-green-700">Se ha enviado tu solicitud. Te contactaremos en breve.</p>
									</div>
								</div>
							}
							<!-- Actions: Mobile stacked, Desktop side-by-side -->
							<div class="flex flex-col space-y-3 md:flex-row md:space-y-0 md:space-x-4 pt-4">
								<a
									href="/catalogo"
									onclick="return confirmNavigation()"
									class="flex-1 bg-gray-200 text-gray-700 text-base md:text-lg font-bold py-3 px-6 rounded text-center hover:bg-gray-300 transition-colors"
								>
									Explorar Catálogo
								</a>
								<button
									type="submit"
									class="flex-1 bg-accent text-base md:text-lg text-light font-bold py-3 px-6 rounded hover:cursor-pointer hover:scale-105 transition-[scale] active:scale-95 focus:outline-none focus:ring-4 focus:ring-blue-500 relative"
									id="quote-request-submit-btn"
								>
									<span class="form-loading htmx-indicator absolute inset-0 flex items-center justify-center">
										@components.LoadingIcon("w-6 md:w-8 text-light", nil)
									</span>
									if len(formState.Cart) > 0 {
										<span class="form-submit-text">Solicitar Cotización</span>
									} else {
										<span class="form-submit-text">Consultar Disponibilidad</span>
									}
								</button>
							</div>
						</form>
					}
				</div>
			</div>
		</main>
		@quoteRequestScript()
	}
}

templ quoteCartItem(item *db.CartItem) {
	<div class="flex flex-col space-y-2 md:flex-row md:space-y-0 md:space-x-4 md:items-center p-3 bg-white rounded-md border border-gray-200">
		<div class="flex-1 min-w-0">
			<h4 class="font-medium text-gray-900 truncate">{ item.Name }</h4>
			if item.Category != "" {
				<p class="text-sm text-gray-600">{ item.Category }</p>
			}
		</div>
		<div class="flex items-center space-x-3 justify-between md:justify-start">
			<!-- Quantity Controls -->
			<div class="flex items-center space-x-2">
				<button
					type="button"
					hx-put={ fmt.Sprintf("/cotizacion/carrito/items/%s", item.ProductID) }
					hx-vals={ fmt.Sprintf(`{"quantity": %d}`, max(1, item.Quantity-1)) }
					hx-target="#cart-items"
					hx-target-error="#cart-items"
					hx-swap="outerHTML"
					class="w-8 h-8 flex items-center justify-center bg-gray-100 hover:bg-gray-200 rounded-md text-gray-600 hover:text-gray-800 transition-colors disabled:bg-gray-50 disabled:text-gray-400 disabled:cursor-not-allowed"
					disabled?={ item.Quantity <= 1 }
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"></path>
					</svg>
				</button>
				<span class="w-8 text-center font-medium text-gray-900">{ fmt.Sprintf("%d", item.Quantity) }</span>
				<button
					type="button"
					hx-put={ fmt.Sprintf("/cotizacion/carrito/items/%s", item.ProductID) }
					hx-vals={ fmt.Sprintf(`{"quantity": %d}`, item.Quantity+1) }
					hx-target="#cart-items"
					hx-target-error="#cart-items"
					hx-swap="outerHTML"
					class="w-8 h-8 flex items-center justify-center bg-gray-100 hover:bg-gray-200 rounded-md text-gray-600 hover:text-gray-800 transition-colors disabled:bg-gray-50 disabled:text-gray-400 disabled:cursor-not-allowed"
					disabled?={ item.Quantity >= item.MaxQty }
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
					</svg>
				</button>
			</div>
			<!-- Remove Button -->
			<button
				type="button"
				hx-delete={ fmt.Sprintf("/cotizacion/carrito/items/%s", item.ProductID) }
				hx-target="#cart-items"
				hx-target-error="#cart-items"
				hx-swap="outerHTML"
				hx-confirm="¿Eliminar este producto del carrito?"
				class="w-8 h-8 flex items-center justify-center bg-red-50 hover:bg-red-100 rounded-md text-red-600 hover:text-red-800 transition-colors"
				title="Eliminar producto"
			>
				<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
				</svg>
			</button>
		</div>
	</div>
}

templ quoteRequestScript() {
	<script>
		// Form data change tracking
		let formChanged = false;
		
		// Navigation confirmation
		function confirmNavigation() {
			if (formChanged) {
				return confirm('¿Estás seguro de que quieres salir? Se perderán los datos del formulario.');
			}
			return true;
		}
		
		// Make confirmNavigation globally available
		window.confirmNavigation = confirmNavigation;
		
		document.addEventListener('DOMContentLoaded', function() {
			const form = document.getElementById('quote-request-form');
			// Track form changes
			if (form) {
				form.addEventListener('input', function() {
					formChanged = true;
				});
				
				form.addEventListener('change', function() {
					formChanged = true;
				});
			}
		
			// Handle form submission animations
            eventManager
                .register('beforeRequest', '#quote-request-form', function(e) {
                }, { preventExternal: true })
                .register('afterRequest', '#quote-request-form', function(e) {
					if (e.detail.xhr.status === 200) {
						formChanged = false;
						// Redirect will be handled by server response
						setTimeout(() => {
							window.location.href = '/';
						}, 2000);
					}
                }, { preventExternal: true })
		});
	</script>
}
