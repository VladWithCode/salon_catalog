package pages

import "github.com/vladwithcode/salon_catalog/internal/templates"
import "github.com/vladwithcode/salon_catalog/internal/templates/components"

templ Index(catalogListings components.CatalogListings) {
	@templates.BaseLayout("Villa Chenacolo", nil, true) {
		@Script()
		<section id="seccion-hero" class="relative z-0 mb-8 sm:mb-12 lg:mb-16">
			<div class="absolute inset-0 -z-10">
				<video
					src="/static/assets/chenacolo_vid.mp4"
					alt="Salon Hero Background"
					class="w-full h-full object-cover object-center"
					autoplay
					muted
					loop
					playsinline
				></video>
			</div>
			<div class="bg-gradient-to-br from-primary/60 to-accent/60 flex flex-col items-center justify-center h-[70vh] sm:h-[80vh] lg:h-[90vh]">
				<h1 class="text-stone-50 text-6xl font-serif sm:text-3xl lg:text-4xl xl:text-5xl text-center font-semibold px-4 sm:px-6 lg:px-8 mb-4 sm:mb-6 opacity-0 translate-y-6" data-hero-item>
					Villa Chenacolo
				</h1>
				<p class="text-stone-100 font-bold text-center sm:text-lg lg:text-xl px-4 sm:px-6 lg:px-8 opacity-0 translate-y-6" data-hero-item>
					Celebra con una <span class="uppercase">Elegancia</span> inigualable.
				</p>
				<a
					href="#seccion-contacto"
					class="text-secondary text-lg sm:text-xl text-center font-bold px-6 sm:px-8 py-3 sm:py-4 border-2 border-accent mt-8 sm:mt-12 lg:mt-16 transition-[background,color,font-weight] duration-120 bg-accent shadow shadow-dark/35 hover:bg-secondary hover:text-primary hover:border-current opacity-0 translate-y-6 rounded-sm"
					data-hero-item
				>
					¡Agenda ya!
				</a>
			</div>
		</section>
		<section id="seccion-oferta" class="px-4 sm:px-6 lg:px-8 mb-8 sm:mb-12 lg:mb-16">
			<h2 class="text-2xl sm:text-3xl lg:text-4xl text-center font-bold mb-4 sm:mb-6 translate-y-6 opacity-0 uppercase" data-intsc-animate-item="offer-section">Nuestra Oferta</h2>
			<p class="text-center text-base sm:text-lg mb-8 sm:mb-12 translate-y-6 opacity-0" data-intsc-animate-item="offer-section">Conoce los servicios que tenemos para tu evento.</p>
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 max-w-7xl mx-auto">
				<div
					class="relative shadow shadow-stone-800/50 aspect-[5/4] z-0 transition-[scale] group hover:scale-105 hover:cursor-pointer active:scale-105 active:cursor-pointer translate-y-6 opacity-0 rounded-lg overflow-hidden"
					data-intsc-animate-item="offer-section"
				>
					<img
						src="/static/assets/chenacolo_11.jpeg"
						alt="Imagen del recibidor del salon de eventos"
						class="absolute inset-0 w-full h-full object-cover object-center z-0"
					/>
					<div
						class="bg-stone-800/50 text-stone-50 relative w-full h-full z-10 p-4 sm:p-6 transition-[background] group-hover:bg-primary/80 group-active:bg-primary/80"
					>
						<h3 class="text-lg sm:text-xl font-bold tracking-wide uppercase mb-4 sm:mb-6">Cualquier evento</h3>
						<p class="text-sm sm:text-base max-w-[24ch]">
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus.
						</p>
					</div>
					<a href="/servicios" class="absolute text-sm sm:text-lg font-semibold bottom-4 right-4 z-10 text-stone-50 underline">
						Conoce nuestros servicios >
					</a>
				</div>
				<div
					class="relative shadow shadow-stone-800/50 aspect-[5/4] z-0 transition-[scale] group hover:scale-105 hover:cursor-pointer active:scale-105 active:cursor-pointer translate-y-6 opacity-0 rounded-lg overflow-hidden"
					data-intsc-animate-item="offer-section"
				>
					<img
						src="/static/assets/chenacolo_18.jpeg"
						alt="Imagen del area de mesas del salon de eventos"
						class="absolute inset-0 w-full h-full object-cover object-center z-0"
					/>
					<div
						class="bg-stone-800/50 text-stone-50 relative w-full h-full z-10 p-4 sm:p-6 transition-[background] group-hover:bg-primary/80 group-active:bg-primary/80"
					>
						<h3 class="text-lg sm:text-xl font-bold tracking-wide uppercase mb-4 sm:mb-6">El material adecuado</h3>
						<p class="text-sm sm:text-base max-w-[24ch]">
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus.
						</p>
					</div>
					<a href="/catalogo" class="absolute text-sm sm:text-lg font-semibold bottom-4 right-4 z-10 text-stone-50 underline">
						Conoce nuestro catalogo >
					</a>
				</div>
				<div
					class="relative shadow shadow-stone-800/50 aspect-[5/4] z-0 transition-[scale] group hover:scale-105 hover:cursor-pointer active:scale-105 active:cursor-pointer translate-y-6 opacity-0 rounded-lg overflow-hidden md:col-span-2 lg:col-span-1"
					data-intsc-animate-item="offer-section"
				>
					<img
						src="/static/assets/chenacolo_8.jpeg"
						alt="Imagen del area de descanso del salon de eventos"
						class="absolute inset-0 w-full h-full object-cover object-center z-0"
					/>
					<div
						class="bg-stone-800/50 text-stone-50 relative w-full h-full z-10 p-4 sm:p-6 transition-[background] group-hover:bg-primary/80 group-active:bg-primary/80"
					>
						<h3 class="text-lg sm:text-xl font-bold tracking-wide uppercase mb-4 sm:mb-6">Todo el espacio</h3>
						<p class="text-sm sm:text-base max-w-[24ch]">
							Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed non risus.
						</p>
					</div>
					<a href="/salon" class="absolute text-sm sm:text-lg font-semibold bottom-4 right-4 z-10 text-stone-50 underline">
						Conoce nuestro salón >
					</a>
				</div>
			</div>
		</section>
		@components.CatalogSection(catalogListings)
		<section id="seccion-galeria" class="py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 relative">
			<h2 class="text-2xl sm:text-3xl lg:text-4xl text-center font-bold mb-4 sm:mb-6 translate-y-6 opacity-0 uppercase" data-intsc-animate-item="gallery-section">Galería</h2>
			<p class="text-center text-base sm:text-lg mb-8 sm:mb-12 translate-y-6 opacity-0" data-intsc-animate-item="gallery-section">Aquí encontrarás fotos y videos de eventos que hemos organizado.</p>
			<div class="grid grid-cols-2 gap-3 sm:gap-4 lg:gap-6 md:grid-cols-3 lg:grid-cols-4 max-w-7xl mx-auto">
				<a
					href="#"
					class="block relative w-full aspect-square overflow-hidden transition-[scale] group hover:scale-110 translate-y-6 opacity-0 rounded-lg"
					data-intsc-animate-item="gallery-section"
				>
					<img
						src="/static/assets/chenacolo_25.jpeg"
						alt="Imagen del area de bar del salon de eventos"
						class="absolute inset-0 w-full aspect-square object-cover object-center z-0"
					/>
				</a>
				<a
					href="#"
					class="block relative w-full aspect-square overflow-hidden transition-[scale] group hover:scale-110 translate-y-6 opacity-0 rounded-lg"
					data-intsc-animate-item="gallery-section"
				>
					<img
						src="/static/assets/chenacolo_30.jpeg"
						alt="Imagen del area de bar del salon de eventos"
						class="absolute inset-0 w-full aspect-square object-cover object-left-bottom z-0"
					/>
				</a>
				<a
					href="#"
					class="block relative w-full aspect-square overflow-hidden transition-[scale] group hover:scale-110 translate-y-6 opacity-0 rounded-lg"
					data-intsc-animate-item="gallery-section"
				>
					<img
						src="/static/assets/chenacolo_31.jpeg"
						alt="Imagen del area de bar del salon de eventos"
						class="absolute inset-0 w-full aspect-square object-cover object-center z-0"
					/>
				</a>
				<a
					href="#"
					class="block relative w-full aspect-square overflow-hidden transition-[scale] group hover:scale-110 translate-y-6 opacity-0 rounded-lg"
					data-intsc-animate-item="gallery-section"
				>
					<img
						src="/static/assets/chenacolo_23.jpeg"
						alt="Imagen del area de bar del salon de eventos"
						class="absolute inset-0 w-full aspect-square object-cover object-center z-0"
					/>
				</a>
			</div>
			<p class="text-primary text-base sm:text-lg text-right font-bold underline mt-8 sm:mt-12">
				<a class="tracking-normal hover:tracking-wide transition-all" href="/salon">Ver todas ></a>
			</p>
		</section>
		<section id="seccion-nosotros" class="py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 relative bg-brand-1 text-light">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold mb-6 sm:mb-8 uppercase">¿Quienes somos?</h2>
				<p class="text-base sm:text-lg lg:text-xl font-bold leading-relaxed">
					Salon eventos es una empresa que se dedica a ofrecer una experiencia de eventos innovadora y personalizada
					para todas las personas.
				</p>
			</div>
		</section>
		<section id="seccion-contacto" class="py-12 sm:py-16 lg:py-20 px-4 sm:px-6 lg:px-8 relative">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-2xl sm:text-3xl lg:text-4xl text-center font-bold mb-4 sm:mb-6 uppercase">Contactanos</h2>
				<p class="text-center text-base sm:text-lg mb-8 sm:mb-12">Si deseas agendar una fecha o recibir más información, contáctanos.</p>
				<div class="flex flex-col lg:flex-row lg:gap-8 items-center lg:items-start justify-center">
					<form class="bg-paper text-dark rounded-t-lg lg:rounded-lg w-full max-w-md lg:max-w-lg px-4 sm:px-6 py-8 pb-12 lg:pb-8">
						<h3 class="text-xl sm:text-2xl font-extrabold mb-4 uppercase">Dejanos tus datos</h3>
						<p class="font-semibold mb-6 sm:mb-8 text-sm sm:text-base">Nos pondremos en contacto lo antes posible.</p>
						<div class="space-y-4 sm:space-y-6">
							<div class="space-y-1 sm:space-y-2">
								<label for="name" class="block font-medium text-sm sm:text-base">Nombre</label>
								<input
									type="text"
									id="name"
									name="name"
									class="bg-light text-dark border-stone-400 border rounded px-3 sm:px-4 py-2 sm:py-3 w-full outline-primary text-sm sm:text-base"
									required
								/>
							</div>
							<div class="space-y-1 sm:space-y-2">
								<label for="phone" class="block font-medium text-sm sm:text-base">Teléfono</label>
								<input
									type="tel"
									id="phone"
									name="phone"
									class="bg-light text-dark border-stone-400 border rounded px-3 sm:px-4 py-2 sm:py-3 w-full outline-primary text-sm sm:text-base"
									required
								/>
							</div>
						</div>
						<div class="mt-6 sm:mt-8">
							<button
								class="w-full bg-accent text-base sm:text-lg text-light font-bold py-2 sm:py-3 px-4 rounded hover:cursor-pointer hover:scale-105 transition-[scale] active:scale-95"
							>Enviar</button>
						</div>
					</form>
					<div class="w-full max-w-md lg:max-w-lg -mt-4 lg:mt-0 px-4 sm:px-6 py-8 bg-primary text-light rounded-lg">
						<h3 class="text-xl sm:text-2xl font-extrabold mb-4 uppercase">Encuentranos</h3>
						<p class="font-semibold mb-6 sm:mb-8 text-sm sm:text-base">Estos son todos los medios por los que puedes contactarnos.</p>
						<div class="space-y-4 sm:space-y-6">
							<div class="grid grid-cols-[auto_1fr] grid-rows-[1fr] gap-x-3">
								<div class="row-span-2 col-start-1 w-10 sm:w-12 self-center">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="h-5 w-5 sm:h-6 sm:w-6 m-auto"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
										></path>
									</svg>
								</div>
								<h3 class="row-span-1 col-start-2 text-xs sm:text-sm font-bold">Email</h3>
								<p class="col-start-2 text-sm sm:text-base">salon@eventos.com</p>
							</div>
							<div class="grid grid-cols-[auto_1fr] grid-rows-[1fr] gap-x-3">
								<div class="row-span-2 col-start-1 w-10 sm:w-12 self-center">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="h-5 w-5 sm:h-6 sm:w-6 m-auto text-light"
										fill="none"
										viewBox="0 0 512 512"
										stroke="currentColor"
										stroke-width="2"
									>
										<path
											d="M352 176h-48c-8.8 0-16 7.2-16 16v32h64l-8 64h-56v160h-64V288h-48v-64h48v-40c0-39.8 32.2-72 72-72h56v64z"
											fill="#fff"
										></path>
									</svg>
								</div>
								<h3 class="row-span-1 col-start-2 text-xs sm:text-sm font-bold">Facebook</h3>
								<p class="col-start-2 text-sm sm:text-base">Salon Eventos</p>
							</div>
							<div class="grid grid-cols-[auto_1fr] grid-rows-[1fr] gap-x-3">
								<div class="row-span-2 col-start-1 w-10 sm:w-12 self-center">
									<svg
										xmlns="http://www.w3.org/2000/svg"
										class="h-5 w-5 sm:h-6 sm:w-6 m-auto text-light"
										fill="none"
										viewBox="0 0 24 24"
										stroke="currentColor"
										stroke-width="2"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
										></path>
									</svg>
								</div>
								<h3 class="row-span-1 col-start-2 text-xs sm:text-sm font-bold">Telefono</h3>
								<p class="col-start-2 text-sm sm:text-base">618 123 4455</p>
							</div>
						</div>
						<div class="space-y-1 sm:space-y-2 text-center mt-6 sm:mt-8">
							<p class="text-xs sm:text-sm tracking-wide text-current/80">O también puedes reservar ahora:</p>
							<a href="/reservaciones" class="block w-full py-3 sm:py-4 bg-accent text-base sm:text-lg font-bold mb-4 rounded-sm">¡Agenda ya!</a>
						</div>
					</div>
				</div>
			</div>
		</section>
	}
}

templ Script() {
	<script>
        document.addEventListener("DOMContentLoaded", function () {
            const tl = gsap.timeline();

            tl.to("[data-hero-item]", {
                y: "0px",
                opacity: 1,
                duration: 0.4,
                stagger: 0.15,
            });

            const intscObsv = new IntersectionObserver(function (entries, observer) {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        tl.to(entry.target, {
                            y: "0px",
                            opacity: 1,
                            duration: 0.4,
                            stagger: 0.15,
                        }, ">");

                        observer.unobserve(entry.target);
                    }
                });
            }, {
                threshold: 0.25
            });

            let observedElems = document.querySelectorAll("[data-intsc-animate-item]")
            for (let elem of observedElems) {
                intscObsv.observe(elem);
            }
        });
    </script>
}
