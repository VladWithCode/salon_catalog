package pages

import (
	"encoding/json"
	"github.com/vladwithcode/salon_catalog/internal/templates"
	"github.com/vladwithcode/salon_catalog/internal/templates/components"
	"net/http"
)

type CatalogState struct {
	Search         string `json:"buscar,omitempty"`
	ActiveCategory string `json:"categoria,omitempty"`
	Page           string `json:"pagina,omitempty"`
	Limit          string `json:"por_pagina,omitempty"`
}

func NewCatalogStateFromRequest(r *http.Request) *CatalogState {
	return &CatalogState{
		Search:         r.URL.Query().Get("buscar"),
		ActiveCategory: r.URL.Query().Get("categoria"),
		Page:           r.URL.Query().Get("pagina"),
		Limit:          r.URL.Query().Get("por_pagina"),
	}
}

func (s *CatalogState) HasParams() bool {
	return s.Search != "" || s.ActiveCategory != "" || s.Page != "" || s.Limit != ""
}

func (s *CatalogState) Serialize() string {
	data, err := json.Marshal(s)
	if err != nil {
		return ""
	}

	return string(data)
}

templ Catalog(state *CatalogState) {
	@templates.BaseLayout("Catálogo - Villa Chenacolo", nil, false) {
		@CatalogScript()
		<div class="fixed bottom-20 right-4 z-40">
			<button id="scroll-top-btn" class="bg-dark text-secondary rounded-xs p-2 opacity-0 pointer-events-none">
				<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="5" d="M5 15l7-7 7 7"></path>
				</svg>
			</button>
		</div>
		<div id="scroll-top-btn-threshold" class="absolute top-[20vh] inset-x-0 h-0 w-full"></div>
		<!-- Hero Section -->
		<section class="relative overflow-hidden">
			<div class="absolute inset-0">
				<img src="/static/assets/chenacolo-st-1.jpg" alt="Catálogo de equipos" class="w-full h-full object-cover"/>
			</div>
			<div class="bg-gradient-to-br from-primary/70 to-accent/70 relative pt-32 pb-20 z-10">
				<h1 class="text-4xl leading-tight font-bold text-white px-4 uppercase">
					Catálogo 
					<span class="whitespace-nowrap">Villa Chenacolo</span>
				</h1>
			</div>
		</section>
		<!-- Wizard vs Browse Choice -->
		/* <section class="py-8 px-4 bg-stone-50" id="catalog-intro">
			<div class="max-w-4xl mx-auto text-center">
				<h2 class="text-2xl font-bold mb-4">¿Cómo quieres planear tu evento?</h2>
				<div class="grid md:grid-cols-2 gap-6 mt-8">
					<!-- Wizard Option -->
					<div
						class="bg-white p-6 rounded-lg shadow-lg border-2 border-transparent hover:border-accent transition-colors"
					>
						<div class="text-accent mb-4">
							<svg class="w-16 h-16 mx-auto" fill="currentColor" viewBox="0 0 20 20">
								<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-2">Asistente de Planeación</h3>
						<p class="text-gray-600 mb-4">Te guiamos paso a paso para crear el evento perfecto</p>
						<button
							class="w-full bg-accent text-white py-3 px-6 rounded-lg font-semibold hover:bg-accent/90 transition-colors"
							hx-get="/wizard/categories"
							hx-target="#wizard-modal"
							hx-trigger="click"
							data-wizard-trigger
						>
							Usar Asistente
						</button>
					</div>
					<!-- Browse Option -->
					<div
						class="bg-white p-6 rounded-lg shadow-lg border-2 border-transparent hover:border-primary transition-colors"
					>
						<div class="text-primary mb-4">
							<svg class="w-16 h-16 mx-auto" fill="currentColor" viewBox="0 0 20 20">
								<path
									d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"
								></path>
							</svg>
						</div>
						<h3 class="text-xl font-bold mb-2">Explorar Catálogo</h3>
						<p class="text-gray-600 mb-4">Navega libremente por todos nuestros productos</p>
						<button
							class="w-full bg-primary text-white py-3 px-6 rounded-lg font-semibold hover:bg-primary/90 transition-colors"
							data-click-handler-selector="browse-trigger"
							data-browse-trigger
						>
							Ver Catálogo
						</button>
					</div>
				</div>
			</div>
		</section> */
		<div id="catalog-browse" class="relative">
			<!-- Search Bar -->
			<section class="py-4 px-4 bg-white" id="catalog-search" data-active-search="">
				<div class="max-w-6xl mx-auto">
					@components.SearchBar(state.Search)
				</div>
			</section>
			<!-- Category Filters -->
			<div class="h-px w-screen" id="scroll-filters-threshold"></div>
			<section class="relative py-4 px-4 bg-white z-20" id="category-filters" data-active-category="">
				<div class="max-w-6xl mx-auto">
					<div
						hx-get="/catalog/categories"
						hx-trigger="load"
						hx-target="this"
						hx-swap="innerHTML"
						if state.HasParams() {
							hx-vals={ state.Serialize() }
						}
						data-ctg-filters-container
					>
						<p class="text-xl font-bold text-primary flex items-center justify-center gap-4">
							@components.LoadingIcon("h-8", nil)
							Cargando categorías...
						</p>
						<!-- Categories loaded here -->
					</div>
				</div>
			</section>
			<!-- Products Grid -->
			<section class="relative grid" id="catalog-products">
				<div
					data-products-spinner
					class="col-start-1 row-start-1 py-32 bg-gray-100 opacity-0 pointer-events-none transition-[opacity] duration-300 [&.htmx-request]:opacity-100 [&.htmx-request]:pointer-events-auto z-10"
				>
					<div class="flex flex-col items-center pt-8 gap-4 py-24 text-xl font-bold text-primary">
						@components.LoadingIcon("h-16", nil)
						<p class="text-lg">Cargando productos...</p>
					</div>
				</div>
				<div id="products" class="relative z-0 max-w-6xl py-8 px-4 col-start-1 row-start-1 mx-auto">
					<div
						hx-get="/catalog/products"
						hx-trigger="load"
						hx-target="this"
						hx-swap="outerHTML"
						hx-indicator="[data-products-spinner]"
						if state.HasParams() {
							hx-vals={ state.Serialize() }
						}
					></div>
				</div>
			</section>
		</div>
		<!-- Product Modal Container -->
		<div id="product-modal"></div>
		<!-- Floating Cart -->
		@components.FloatingCart()
		<!-- Wizard Modal -->
		<div id="wizard-modal" class="fixed inset-0 bg-black/50 z-50 hidden opacity-0 pointer-events-none">
			<!-- Wizard content loaded here -->
		</div>
	}
}

templ CatalogScript() {
	<script>
    let currentAnimations = [];

    document.addEventListener('DOMContentLoaded', function () {
        window.eventManager
            .register('beforeSwap', 'products-grid', handleProductsBeforeSwap)
            .register('afterSwap', 'product-modal', handleProductModal)
            .register('beforeRequest', 'category-filter', handleCategoryFilterBeforeRequest)
            .register('beforeRequest', 'search-input', handleSearchBeforeRequest)
            .register('afterRequest', 'add-to-cart', handleCartAfterRequest)
            .register('configRequest', 'search-input', handleCatalogSearchConfigRequest)
            .register('configRequest', 'category-filter', handleCatalogCtgFilterConfigRequest)
            .registerClick('browse-trigger', handleBrowseTrigger)
            .registerClick('close-modal', closeProductModal)
            .registerClick('category-filter', handleCategoryFilterClick);

        function handleCategoryFilterClick(e) {
            window.scrollTo(0, 0);
            document.getElementById('category-filters').dataset.activeCategory = e.target.dataset.categoryFilter;
        }
        function handleBrowseTrigger(e) {
            gsap.to('#catalog-intro', {
                opacity: 0,
                y: -20,
                duration: 0.3,
            });
            gsap.set('#catalog-intro', {display: 'none'});
            gsap.set('#catalog-browse', {display: 'block'})
            gsap.fromTo(['#catalog-search', '#category-filters', '#catalog-products'],
                {opacity: 0, y: 20},
                {opacity: 1, y: 0, duration: 0.4, stagger: 0.1}
            );
            window.scrollTo(0, 0);
        }
        function handleProductsBeforeSwap(e) {
            if (e.detail.xhr.status !== 200) {
                return;
            }

            // Prevent animation overlap
            currentAnimations.forEach(anim => anim.kill());
            currentAnimations = [];

            setTimeout(() => animateProducts(), 50);
        }
        function animateProducts() {
            const container = document.querySelector('[data-products-container]');
            const products = document.querySelectorAll('[data-product-id]');

            if (!container || products.length === 0) return;

            // Clear previous animations
            gsap.killTweensOf(products);
            gsap.killTweensOf(container);

            // Set initial state
            gsap.set(products, {opacity: 0, y: 30});
            gsap.to(container, {opacity: 1, height: 'auto'});

            // Animate products in
            const tl = gsap.timeline({defaults: {duration: 0.4, ease: "power2.out"}});
            const anim = tl.to(products, {
                opacity: 1,
                y: 0,
                stagger: 0.05,
            });

            currentAnimations.push(anim);
        }

        function handleCategoryFilterBeforeRequest(e) {
            // Remove active state from all filters
            document.querySelectorAll('[data-category-filter]').forEach(btn => {
                btn.className = btn.className
                    .replace('bg-accent text-white', 'bg-gray-200 text-gray-700 hover:bg-gray-300');
            });

            // Add active state to clicked filter  
            e.detail.elt.className = e.detail.elt.className
                .replace('bg-gray-200 text-gray-700 hover:bg-gray-300', 'bg-accent text-white');
        }

        function handleCatalogSearchConfigRequest(e) {
            const activeCtg = document.querySelector('[data-active-category]').dataset.activeCategory;
            e.detail.parameters.set('category', activeCtg);
        }
        function handleCatalogCtgFilterConfigRequest(e) {
            const activeSearch = document.querySelector('[data-active-search]').dataset.activeSearch;
            e.detail.parameters.set('search', activeSearch);
        }

        function handleSearchBeforeRequest(e) {
            const container = document.querySelector('[data-products-container]');
            if (container) {
                gsap.to(container, {opacity: 0.5, duration: 0.2});
            }
            document.getElementById('catalog-search').dataset.activeSearch = e.detail.elt.value;
        }

        function handleCartBeforeRequest(e) {
            if (e.detail.elt.matches('[data-add-to-cart]')) {
                startAddItemLoad(e.detail.elt);
            } else if (e.detail.elt.closest('[data-add-to-cart]')) {
                startAddItemLoad(e.detail.elt.closest('[data-add-to-cart]'));
            }
        }

        function handleCartAfterRequest(e) {
            let success = e.detail.xhr.status === 200;

            if (e.detail.elt.matches('[data-add-to-cart]')) {
                stopAddItemLoad(e.detail.elt, success);
            } else if (e.detail.elt.closest('[data-add-to-cart]')) {
                stopAddItemLoad(e.detail.elt.closest('[data-add-to-cart]'), success);
            }
        }

        function showWizardModal() {
            const modal = document.getElementById('wizard-modal');
            modal.classList.remove('hidden');
            gsap.to(modal, {
                opacity: 1,
                duration: 0.3,
                onComplete: () => {
                    modal.classList.remove('pointer-events-none');
                }
            });
        }
        function closeWizardModal() {
            const modal = document.getElementById('wizard-modal');
            modal.classList.add('pointer-events-none');
            gsap.to(modal, {
                opacity: 0,
                duration: 0.3,
                onComplete: () => {
                    modal.classList.add('hidden');
                    modal.innerHTML = '';
                }
            });
        }

        function handleProductModal(e) {
            const modal = document.getElementById('product-modal');
            gsap.fromTo(modal,
                {opacity: 0, scale: 0.9},
                {opacity: 1, scale: 1, duration: 0.3, ease: "back.out(1.7)"}
            );
        }
        function closeProductModal() {
            const modal = document.getElementById('product-modal');
            gsap.to(modal, {
                opacity: 0,
                scale: 0.9,
                duration: 0.2,
                onComplete: () => {
                    modal.innerHTML = '';
                }
            });
        }

        function startAddItemLoad(button) {
            gsap.to('[data-add-item-label]', {
                height: '0%',
                duration: 0.3,
                ease: 'power2.out',
            });
            gsap.to('[data-add-item-spinner]', {
                height: '',
                duration: 0.3,
                ease: 'power2.out',
            }, "-=0.15");
        }

        function stopAddItemLoad(button, success) {
            const feedback = success
                ? button.querySelector('[data-add-item-success]')
                : button.querySelector('[data-add-item-error]');

            // Animate button
            gsap.to(feedback, {
                opacity: 1,
                duration: 0.3,
                ease: 'power2.out',
            });
            setTimeout(() => {
                gsap.set('[data-add-item-label]', {
                    height: '',
                });
                gsap.set('[data-add-item-spinner]', {
                    height: '0%',
                });
                gsap.to(feedback, {
                    opacity: 0,
                    duration: 0.3,
                    ease: 'power2.out',
                });
            }, 1500);
        }

        const scrollTopBtn = document.getElementById('scroll-top-btn');
        const scrollTopBtnThreshold = document.getElementById('scroll-top-btn-threshold');
        const obsv = new IntersectionObserver(function (entries, observer) {
            entries.forEach(entry => {
                if (!entry.isIntersecting) {
                    gsap.to(scrollTopBtn, {
                        opacity: 1,
                        duration: 0.3,
                        ease: "power2.out",
                        pointerEvents: "auto",
                    });
                } else {
                    gsap.to(scrollTopBtn, {
                        opacity: 0,
                        duration: 0.3,
                        ease: "power2.out",
                        pointerEvents: "none",
                    });
                }
            });
        }, {
            threshold: 0.25
        });
        obsv.observe(scrollTopBtnThreshold);
        scrollTopBtn.addEventListener('click', function (e) {
            window.scrollTo(0, 0);
        });

        const ctgFiltersObsv = new IntersectionObserver(function (entries, observer) {
            entries.forEach(entry => {
                if (!entry.isIntersecting) {
                    gsap.to('#category-filters', {
                        position: "fixed",
                        top: getTopNavHeight() + "px",
                        left: 0,
                        right: 0,
                    });
                } else {
                    gsap.to('#category-filters', {
                        position: "",
                        top: "",
                        left: "",
                        right: "",
                    });
                }
            });
        });
        ctgFiltersObsv.observe(document.getElementById('scroll-filters-threshold'));

        function getTopNavHeight() {
            return String(document.getElementById('header').clientHeight);
        }
    });
</script>
}
