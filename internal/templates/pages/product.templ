package pages

import "github.com/vladwithcode/salon_catalog/internal/templates"
import "github.com/vladwithcode/salon_catalog/internal/templates/components"
import "github.com/vladwithcode/salon_catalog/internal/db"

templ Product(product *db.Product) {
	@templates.BaseLayout(product.Name + " - Villa Chenacolo", nil, false) {
		<div class="min-h-screen bg-gray-50">
			<!-- Product Hero Section -->
			<section class="bg-white">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
					<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
						<!-- Product Images -->
						<div class="space-y-4">
							<!-- Main Image -->
							<div class="aspect-square w-full bg-gray-100 rounded-lg overflow-hidden">
								if product.MainImg != "" {
									<img
										src={ "/static/uploads/" + product.MainImg }
										alt={ "Imagen principal de " + product.Name }
										class="w-full h-full object-cover cursor-pointer hover:scale-105 transition-transform duration-300"
										onclick="openGalleryModal(0)"
									/>
								} else {
									<div class="w-full h-full flex items-center justify-center text-gray-400">
										<svg class="w-16 h-16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
										</svg>
									</div>
								}
							</div>
							
							<!-- Gallery Thumbnails -->
							if len(product.Gallery) > 1 {
								<div class="grid grid-cols-4 gap-2 sm:gap-4">
									for i, image := range product.Gallery {
										if i < 4 {
											<div class="aspect-square bg-gray-100 rounded-lg overflow-hidden relative cursor-pointer hover:opacity-75 transition-opacity">
												<img
													src={ "/static/uploads/" + image }
													alt={ "Imagen " + string(rune(i+1)) + " de " + product.Name }
													class="w-full h-full object-cover"
													data-gallery-index={ string(rune(i)) }
													onclick="openGalleryModal(this.dataset.galleryIndex)"
												/>
												if i == 3 && len(product.Gallery) > 4 {
													<div class="absolute inset-0 bg-black bg-opacity-50 flex items-center justify-center text-white font-semibold">
														+{ string(rune(len(product.Gallery) - 3)) }
													</div>
												}
											</div>
										}
									}
								</div>
							}
							
							<!-- View Gallery Button -->
							if len(product.Gallery) > 0 {
								<button
									onclick="openGalleryModal(0)"
									class="w-full py-3 px-4 border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50 transition-colors font-medium"
								>
									Ver galería completa ({ string(rune(len(product.Gallery))) } imágenes)
								</button>
							}
						</div>
						
						<!-- Product Information -->
						<div class="space-y-6">
							<!-- Breadcrumb -->
							<nav class="text-sm text-gray-500">
								<a href="/" class="hover:text-gray-700">Inicio</a>
								<span class="mx-2">/</span>
								<a href="/catalogo" class="hover:text-gray-700">Catálogo</a>
								<span class="mx-2">/</span>
								<span class="text-gray-900">{ product.Name }</span>
							</nav>
							
							<!-- Product Title and Category -->
							<div>
								<p class="text-sm font-medium text-primary mb-2">{ product.Category }</p>
								<h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 mb-4">{ product.Name }</h1>
							</div>
							
							<!-- Availability Status -->
							<div class="flex items-center space-x-2">
								if product.Available {
									<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-green-100 text-green-800">
										<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
										</svg>
										Disponible
									</span>
								} else {
									<span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-red-100 text-red-800">
										<svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
											<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
										</svg>
										No disponible
									</span>
								}
								if product.Quantity > 0 {
									<span class="text-sm text-gray-600">
										Cantidad: { string(rune(product.Quantity)) }
									</span>
								}
							</div>
							
							<!-- Description -->
							<div class="prose prose-gray max-w-none">
								<p class="text-lg text-gray-700 leading-relaxed">{ product.Description }</p>
							</div>
							
							<!-- Long Description -->
							if product.LongDescription != "" {
								<div class="prose prose-gray max-w-none">
									<h3 class="text-lg font-semibold text-gray-900 mb-3">Detalles</h3>
									<div class="text-gray-700 leading-relaxed whitespace-pre-line">{ product.LongDescription }</div>
								</div>
							}
							
							<!-- Action Buttons -->
							<div class="space-y-4 pt-6 border-t border-gray-200">
								if product.Available {
									<button class="w-full bg-primary text-white py-3 px-6 rounded-lg font-semibold hover:bg-primary/90 transition-colors">
										Agregar al carrito
									</button>
									<button class="w-full border border-primary text-primary py-3 px-6 rounded-lg font-semibold hover:bg-primary/5 transition-colors">
										Solicitar cotización
									</button>
								} else {
									<button class="w-full bg-gray-300 text-gray-500 py-3 px-6 rounded-lg font-semibold cursor-not-allowed" disabled>
										No disponible
									</button>
									<button class="w-full border border-primary text-primary py-3 px-6 rounded-lg font-semibold hover:bg-primary/5 transition-colors">
										Consultar disponibilidad
									</button>
								}
							</div>
							
							<!-- Contact Information -->
							<div class="bg-gray-50 rounded-lg p-6 space-y-4">
								<h3 class="font-semibold text-gray-900">¿Necesitas ayuda?</h3>
								<div class="space-y-2 text-sm text-gray-600">
									<p class="flex items-center">
										<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
										</svg>
										618 123 4455
									</p>
									<p class="flex items-center">
										<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
										</svg>
										salon@eventos.com
									</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</section>
			
			<!-- Related Products Section -->
			<section class="bg-white border-t border-gray-200">
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
					<h2 class="text-2xl font-bold text-gray-900 mb-8">Productos relacionados</h2>
					<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6">
						<!-- Placeholder for related products -->
						<div class="text-center text-gray-500 col-span-full py-8">
							<p>Próximamente mostraremos productos relacionados</p>
						</div>
					</div>
				</div>
			</section>
		</div>
		
		<!-- Gallery Modal -->
		@components.GalleryModal(product)
	}
}
