package pages

import "github.com/vladwithcode/salon_catalog/internal/templates"

templ Reservations() {
	@reservationsScript()
	@templates.BaseLayout("Reservaciones | Villa Chenacolo", nil, false) {
		<main class="grid grid-cols-subgrid">
			<section id="seccion-titulo" class="relative z-0">
				<div class="absolute inset-0 z-0">
					<img src="/static/assets/chenacolo_2.jpeg" alt="Imagen del area de bar del salon de eventos" class="w-full h-full object-cover object-center brightness-90" data-view-animate="opacityIn"/>
				</div>
				<div class="relative z-10 px-4 pt-32 pb-16 bg-primary/60">
					<h1 class="text-4xl mb-4 text-light/80" data-view-animate="fadeIn">Reservaciones</h1>
				</div>
			</section>
			<section id="seccion-reservaciones" class="relative z-0 px-4 py-16 space-y-4">
				<form
					id="reservation-form"
					hx-post="/api/reservations"
					hx-swap="outerHTML"
					hx-ext="response-targets"
					class="px-4 py-8 bg-paper rounded-sm shadow-md space-y-4"
				>
					<div class="text-primary">
						<h2 class="text-2xl font-bold">Tus datos</h2>
						<p class="text-current/80">Ingresa tu información de contacto para confirmar tu reserva.</p>
					</div>
					<div class="space-y-1">
						<label for="name" class="block text-sm font-medium text-primary/60">Nombre</label>
						<input type="text" name="name" id="name" class="px-4 py-2 block w-full bg-light bg-light/80 border border-gray-200 rounded-sm"/>
					</div>
					<div class="space-y-1">
						<label for="phone" class="block text-sm font-medium text-primary/60">Teléfono</label>
						<input type="tel" name="phone" id="phone" class="px-4 py-2 block w-full bg-light bg-light/80 border border-gray-200 rounded-sm"/>
					</div>
					<div class="space-y-1">
						<label for="date" class="block text-sm font-medium text-primary/60">Fecha</label>
						<input type="datetime-local" name="date" id="date" class="px-4 py-2 block w-full bg-light bg-light/80 border border-gray-200 rounded-sm" placeholder="DD/MM/YY hh:mm:ss"/>
					</div>
					<button class="block w-full rounded-sm bg-accent text-light font-bold uppercase py-2">Enviar</button>
				</form>
			</section>
		</main>
	}
}

templ reservationsScript() {
}
