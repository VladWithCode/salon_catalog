package pages

import "github.com/vladwithcode/salon_catalog/internal/templates"
import "github.com/vladwithcode/salon_catalog/internal/templates/components"

templ Services() {
	@templates.BaseLayout("Servicios | Villa Chenacolo", nil, false) {
		<main class="grid grid-cols-subgrid">
			<section id="seccion-titulo" class="relative z-0">
				<div class="absolute inset-0 z-0">
					<img
						src="/static/assets/chenacolo_24.jpeg"
						alt="Imagen del area de bar del salon de eventos"
						class="w-full h-full object-cover object-center brightness-90"
						data-view-animate="opacityIn"
					/>
				</div>
				<div class="relative text-secondary z-10 px-4 pt-32 pb-16 bg-primary/60">
					<h1 class="text-4xl font-bold mb-4 uppercase" data-view-animate="fadeIn">Un lugar que eleva cualquier celebración.</h1>
					<p class="font-medium tracking-wide text-current/80">
						En Villa Chenacolo no organizamos tu evento: te entregamos el escenario perfecto para que lo vivas como lo imaginaste, sin complicaciones. Nuestra renta de salón incluye un espacio de alto nivel, con cada detalle pensado para brindar comodidad, elegancia y funcionalidad. Tú eliges a tus proveedores, nosotros ponemos lo mejor para recibirlos.
					</p>
				</div>
			</section>
			<section id="seccion-bodas" class="relative z-0 px-4 py-16 space-y-4">
				<img
					src="/static/assets/chenacolo_11.jpeg"
					alt="Imagen del recibidor del salon de eventos"
					class="w-full aspect-[3/2] object-cover object-center rounded-xs mb-8"
				/>
				<h2 class="relative text-2xl text-primary font-semibold uppercase">
					<span class="block absolute -top-4 h-2 w-24 bg-primary"></span>
					Bodas
				</h2>
				<p class="tracking-wide text-gray-700/80">
					El ‘sí’ más importante merece un lugar como este.
					Capilla íntima y elegante, salón cerrado con aire acondicionado, acústica impecable y áreas exteriores que se integran con armonía.
				</p>
				<ul class="text-gray-700/80 list-disc list-inside">
					<li>Renta de salón y capilla</li>
					<li>Espacio con capacidad ampliable (hasta 200 personas más al abrirse)</li>
					<li>Climatización total</li>
					<li>Iluminación y acústica premium</li>
					<li>Cocina completamente equipada para tu proveedor de banquete</li>
					<li>Estacionamiento amplio dentro y fuera de la villa</li>
					<li>Personal de asistencia, valet y seguridad</li>
				</ul>
				<p class="tracking-wide text-gray-700/80">
					🛠️ Todo el mobiliario disponible se renta por separado.
				</p>
				<a
					target="_blank"
					href={ "https://wa.me/6181556407?text=Hola!+Me+gustaría+conocer+más+sobre+la+planeacion+de+bodas+de+Salón+Chenacolo." }
					class="flex items-center justify-center rounded-full gap-2 text-lg text-secondary font-bold tracking-wide underline underline-offset-2 bg-sky-500 py-4"
				>
					<svg class="h-6 w-6 fill-current">
						<use href="/static/assets/wsp.svg#wsp"></use>
					</svg>
					<span class="block">Más información</span>
				</a>
			</section>
			<section id="seccion-quinceaneras" class="relative z-0 px-4 py-16 bg-paper-dark space-y-4 -mb-px">
				<img
					src="/static/assets/chenacolo_9.jpeg"
					alt="Imagen de un árbol en el fondo de un jardín"
					class="w-full aspect-[3/2] object-cover object-center rounded-xs mb-8"
				/>
				<h2 class="relative text-2xl text-secondary font-semibold">
					<span class="block absolute -top-4 h-2 w-24 bg-current uppercase"></span>
					QUINCEAÑERAS & CELEBRACIONES
				</h2>
				<p class="tracking-wide text-stone-50/80">
					Diseña la fiesta de tus sueños en un espacio que se transforma contigo.
					Desde temáticas juveniles hasta cenas formales, el salón se adapta a tu visión.
				</p>
				<ul class="text-light/80 list-disc list-inside">
					<li>Salón climatizado y cerrado para eventos más íntimos o fiestas grandes</li>
					<li>Espacios exteriores: fuente, puente, jardín y área techada al aire libre para tematizar</li>
					<li>Cocina equipada lista para tu proveedor de catering</li>
					<li>Distribución funcional para áreas de foto, comida y pista de baile</li>
					<li>Personal en baños, seguridad y valet</li>
				</ul>
				<a
					target="_blank"
					href={ "https://wa.me/6181556407?text=Hola!+Me+gustaría+conocer+más+sobre+las+quinceañeras+de+Salón+Chenacolo." }
					class="flex items-center justify-center rounded-full gap-2 text-lg text-secondary font-bold tracking-wide underline underline-offset-2 bg-sky-500 py-4"
				>
					<svg class="h-6 w-6 fill-current">
						<use href="/static/assets/wsp.svg#wsp"></use>
					</svg>
					<span class="block">Me interesa saber más ></span>
				</a>
			</section>
			<section id="seccion-bautizos" class="relative z-0 px-4 py-16 space-y-4 -mb-px">
				<img
					src="/static/assets/chenacolo_7.jpeg"
					alt="Imagen de un árbol en el fondo de un jardín"
					class="w-full aspect-[3/2] object-cover object-center rounded-xs mb-8"
				/>
				<h2 class="relative text-2xl text-primary font-semibold">
					<span class="block absolute -top-4 h-2 w-24 bg-current uppercase"></span>
					BAUTIZOS Y COMUNIONES
				</h2>
				<p class="tracking-wide text-gray-700/80">
					Celebraciones con alma y buen gusto.
					La capilla es perfecta para ceremonias familiares, seguida de un evento en salón o jardín.
				</p>
				<ul class="text-gray-700/80 list-disc list-inside">
					<li>Renta de capilla y salón (opcional por separado)</li>
					<li>Espacios ideales para fotos y reuniones familiares</li>
					<li>Cocina equipada para preparar o calentar alimentos</li>
					<li>Baños impecables con sala privada en el área de mujeres</li>
					<li>Atención personalizada y servicio discreto</li>
				</ul>
				<a
					target="_blank"
					href={ "https://wa.me/6181556407?text=Hola!+Me+gustaría+conocer+más+sobre+los+bautizos+de+Salón+Chenacolo." }
					class="flex items-center justify-center rounded-full gap-2 text-lg text-secondary font-bold tracking-wide underline underline-offset-2 bg-sky-500 py-4"
				>
					<svg class="h-6 w-6 fill-current">
						<use href="/static/assets/wsp.svg#wsp"></use>
					</svg>
					<span class="block">Me interesa saber más ></span>
				</a>
			</section>
			<section id="seccion-corporativos" class="relative z-0 px-4 py-16 bg-primary text-light space-y-4 -mb-px">
				<img
					src="/static/assets/chenacolo_10.jpeg"
					alt="Imagen de un árbol en el fondo de un jardín"
					class="w-full aspect-[3/2] object-cover object-center rounded-xs mb-8"
				/>
				<h2 class="relative text-2xl text-secondary font-semibold">
					<span class="block absolute -top-4 h-2 w-24 bg-current uppercase"></span>
					EVENTOS CORPORATIVOS
				</h2>
				<p class="tracking-wide text-current/80">
					Un entorno elegante para eventos profesionales.
					Ya sea para una cena empresarial, una entrega de premios o un lanzamiento de producto, Chenacolo proyecta profesionalismo y alto nivel.
				</p>
				<ul class="text-current/80 list-disc list-inside">
					<li>Salón con capacidad para grandes montajes</li>
					<li>Estacionamiento para equipo e invitados</li>
					<li>Apoyo en logística de acceso y seguridad</li>
					<li>Zona exterior techada para actividades complementarias</li>
					<li>Cocina y baños disponibles para todo el staff externo</li>
				</ul>
				<a
					target="_blank"
					href={ "https://wa.me/6181556407?text=Hola!+Me+gustaría+conocer+más+sobre+los+eventos+corporativos+de+Salón+Chenacolo." }
					class="flex items-center justify-center rounded-full gap-2 text-lg text-secondary font-bold tracking-wide underline underline-offset-2 bg-sky-500 py-4"
				>
					<svg class="h-6 w-6 fill-current">
						<use href="/static/assets/wsp.svg#wsp"></use>
					</svg>
					<span class="block">Me interesa saber más ></span>
				</a>
			</section>
			<section id="seccion-graduaciones" class="relative z-0 px-4 py-16 text-gray-700 space-y-4 -mb-px">
				<img
					src="/static/assets/chenacolo_14.jpeg"
					alt="Imagen de un árbol en el fondo de un jardín"
					class="w-full aspect-[3/2] object-cover object-center rounded-xs mb-8"
				/>
				<h2 class="relative text-2xl text-primary font-semibold">
					<span class="block absolute -top-4 h-2 w-24 bg-current uppercase"></span>
					GRADUACIONES
				</h2>
				<p class="tracking-wide text-current/80">
					Celebra logros en un lugar con estilo y amplitud.
					Un espacio seguro, bien distribuido y con todo lo necesario para una noche inolvidable.
				</p>
				<ul class="text-current/80 list-disc list-inside">
					<li>Salón principal climatizado</li>
					<li>Zonas exteriores para fotos y áreas de espera</li>
					<li>Cocina lista para uso profesional</li>
					<li>Iluminación y acústica perfectas para ceremonia o fiesta</li>
					<li>Servicio continuo de limpieza en baños y apoyo logístico</li>
				</ul>
				<a
					target="_blank"
					href={ "https://wa.me/6181556407?text=Hola!+Me+gustaría+conocer+más+sobre+las+graduaciones+de+Salón+Chenacolo." }
					class="flex items-center justify-center rounded-full gap-2 text-lg text-secondary font-bold tracking-wide underline underline-offset-2 bg-sky-500 py-4"
				>
					<svg class="h-6 w-6 fill-current">
						<use href="/static/assets/wsp.svg#wsp"></use>
					</svg>
					<span class="block">Me interesa saber más ></span>
				</a>
			</section>
			<section id="seccion-privadas" class="relative z-0 px-4 py-16 bg-primary text-light space-y-4 -mb-px">
				<img
					src="/static/assets/chenacolo_20.jpeg"
					alt="Imagen de un árbol en el fondo de un jardín"
					class="w-full aspect-[3/2] object-cover object-center rounded-xs mb-8"
				/>
				<h2 class="relative text-2xl text-secondary font-semibold">
					<span class="block absolute -top-4 h-2 w-24 bg-current uppercase"></span>
					FIESTAS PRIVADAS
				</h2>
				<p class="tracking-wide text-current/80">
					De lo íntimo a lo espectacular.
					Celebra cumpleaños, aniversarios o reuniones familiares en un entorno que se siente privado, exclusivo y cuidado.
				</p>
				<ul class="text-current/80 list-disc list-inside">
					<li>Espacios personalizables (salón, jardín, zona techada trasera)</li>
					<li>Baños amplios y en constante mantenimiento</li>
					<li>Distribución arquitectónica que hace fluir el evento sin interrupciones</li>
					<li>Privacidad total gracias a la ubicación</li>
					<li>Personal discreto y atento en todo momento</li>
				</ul>
				<a
					target="_blank"
					href={ "https://wa.me/6181556407?text=Hola!+Me+gustaría+conocer+más+sobre+las+fiestas+privadas+de+Salón+Chenacolo." }
					class="flex items-center justify-center rounded-full gap-2 text-lg text-secondary font-bold tracking-wide underline underline-offset-2 bg-sky-500 py-4"
				>
					<svg class="h-6 w-6 fill-current">
						<use href="/static/assets/wsp.svg#wsp"></use>
					</svg>
					<span class="block">Me interesa saber más ></span>
				</a>
			</section>
			@components.CTASection()
		</main>
	}
}

templ ServicesScript() {
	<script>
</script>
}
